[Unit]
Description=AVORA Raspberry Pi Backend
Wants=network-online.target mosquitto.service
After=network-online.target mosquitto.service

[Service]
Type=simple

User=ali
Group=ali

WorkingDirectory=/home/ali/AVORA/RaspberryPi

ExecStart=/home/ali/AVORA/RaspberryPi/.venv/bin/python /home/ali/AVORA/RaspberryPi/main.py

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/avora/mqtt.env
EnvironmentFile=-/etc/avora/feedback-email.env

StandardOutput=journal
StandardError=journal

UMask=0077

[Install]
WantedBy=multi-user.target
