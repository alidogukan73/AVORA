    <string name="backup_scope_settings_title">Garden, zone and irrigation settings</string>
    <string name="backup_scope_settings_message">Includes the garden profile, zones, sensor calibrations, irrigation limits, weather-effect settings and app preferences.</string>
    <string name="backup_scope_records_title">Records and history</string>
    <string name="backup_scope_records_message">Includes irrigation, fertilization, Plant Journal, season, notification and fertilizer stock records.</string>
    <string name="backup_scope_excluded_title">Excluded for security</string>
    <string name="backup_scope_excluded_message">Live sensor measurements, device health, weather cache, pump-valve commands and access keys are excluded from the data backup. Photos are protected through the separate ZIP operation below.</string>
