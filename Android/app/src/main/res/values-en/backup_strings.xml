    <string name="backup_photo_section">Photo archive</string>
    <string name="backup_photo_message">Stores plant, seedling and journal photos in a separate ZIP together with their notes, zone, season, AI analysis and viewing orientation.</string>
    <string name="backup_photo_export_button">Export Photos as ZIP</string>
