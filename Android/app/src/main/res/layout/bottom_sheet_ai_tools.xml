<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_main_menu_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:alpha="0.45"
        android:background="@color/textTertiary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ai_tools_title"
        android:textColor="@color/textPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="14dp"
        android:text="@string/ai_tools_quick_subtitle"
        android:textColor="@color/textSecondary"
        android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAiToolsPlant"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/aiPlantSurface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:rippleColor="@color/focusRing"
        app:strokeColor="@color/aiPlantBorder"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/ai_tools_plant_assistant"
                android:scaleType="centerCrop"
                android:src="@drawable/img_ai_quick_plant"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Avora.AiToolThumbnail"
                app:strokeColor="@color/aiPlantBorder"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_tools_plant_assistant"
                    android:textColor="@color/aiPlantAccent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ai_tools_plant_description"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/ai_tools_open_plant"
                android:src="@drawable/ic_chevron_right_24"
                app:tint="@color/aiPlantAccent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAiToolsSeedling"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/aiSeedlingSurface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:rippleColor="@color/focusRing"
        app:strokeColor="@color/aiSeedlingBorder"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/ai_tools_seedling_assistant"
                android:scaleType="centerCrop"
                android:src="@drawable/img_ai_quick_seedling"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Avora.AiToolThumbnail"
                app:strokeColor="@color/aiSeedlingBorder"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_tools_seedling_assistant"
                    android:textColor="@color/aiSeedlingAccent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ai_tools_seedling_description"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/ai_tools_open_seedling"
                android:src="@drawable/ic_chevron_right_24"
                app:tint="@color/aiSeedlingAccent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAiToolsFertilization"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/aiFertilizerSurface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:rippleColor="@color/focusRing"
        app:strokeColor="@color/aiFertilizerBorder"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/ai_tools_fertilization_assistant"
                android:scaleType="centerCrop"
                android:src="@drawable/img_ai_quick_fertilizer"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Avora.AiToolThumbnail"
                app:strokeColor="@color/aiFertilizerBorder"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_tools_fertilization_assistant"
                    android:textColor="@color/aiFertilizerAccent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ai_tools_fertilization_description"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/ai_tools_open_fertilization"
                android:src="@drawable/ic_chevron_right_24"
                app:tint="@color/aiFertilizerAccent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAiToolsWatering"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/aiWaterSurface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:rippleColor="@color/focusRing"
        app:strokeColor="@color/aiWaterBorder"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/ai_tools_watering_assistant"
                android:scaleType="centerCrop"
                android:src="@drawable/img_ai_quick_watering"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Avora.AiToolThumbnail"
                app:strokeColor="@color/aiWaterBorder"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_tools_watering_assistant"
                    android:textColor="@color/aiWaterAccent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ai_tools_watering_description"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/ai_tools_open_watering"
                android:src="@drawable/ic_chevron_right_24"
                app:tint="@color/aiWaterAccent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
