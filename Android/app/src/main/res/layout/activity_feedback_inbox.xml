<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <include android:id="@+id/feedbackInboxToolbar" layout="@layout/include_settings_toolbar"
        android:layout_width="0dp" android:layout_height="@dimen/settings_toolbar_height"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:layout_width="0dp" android:layout_height="0dp"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/feedbackInboxToolbar"
        app:layout_constraintBottom_toTopOf="@id/feedbackInboxNavigation"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/feedback_inbox_intro"
            android:textColor="@color/textSecondary" android:textSize="13sp" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:scrollbars="none">
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnFeedbackFilterAll"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:checked="true" android:text="@string/feedback_inbox_filter_all" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnFeedbackFilterNew"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/feedback_inbox_filter_new" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnFeedbackFilterRead"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/feedback_inbox_filter_read" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnFeedbackFilterResolved"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/feedback_inbox_filter_resolved" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/txtFeedbackInboxState" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/textSecondary" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFeedbackInboxRefresh"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/superadmin_refresh" />
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressFeedbackInbox" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerFeedbackInbox"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:clipToPadding="false" android:paddingBottom="20dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFeedbackInboxMore"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/feedback_inbox_load_more" android:visibility="gone" />
    </LinearLayout>
    <include android:id="@+id/feedbackInboxNavigation" layout="@layout/include_primary_navigation"
        android:layout_width="0dp" android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
