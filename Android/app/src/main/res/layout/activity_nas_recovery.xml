<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nasRecoveryRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/background">
    <include layout="@layout/include_settings_toolbar" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="24dp" android:orientation="vertical">
            <TextView android:id="@+id/recoveryStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle"
                android:text="@string/nas_recovery_message" />
            <LinearLayout android:id="@+id/recoveryFields" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="@string/data_sync_nas_email"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/recoveryEmail" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textEmailAddress"
                    android:maxLines="1" android:saveEnabled="true"
                    android:importantForAutofill="auto" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recoverySend" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/nas_recovery_send" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="@string/nas_recovery_code"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/recoveryCode" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textVisiblePassword"
                    android:maxLines="1" android:saveEnabled="false"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="@string/data_sync_nas_new_password"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/recoveryPassword" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textPassword"
                    android:maxLines="1" android:saveEnabled="false"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="@string/data_sync_nas_confirm_password"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/recoveryRepeat" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textPassword"
                    android:maxLines="1" android:saveEnabled="false"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/nas_recovery_password_policy" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recoverySubmit" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="@string/nas_recovery_submit" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recoveryDone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:visibility="gone"
                android:text="@string/nas_recovery_done" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
