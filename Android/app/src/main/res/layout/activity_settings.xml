<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsScreenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="88dp">
            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.AVORA.BackButton"
                    android:id="@+id/btnBack"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/back_to_main" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/settings_irrigation_title"
                        android:textAppearance="@style/TextAppearance.AVORA.ScreenTitle" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/settings_irrigation_subtitle"
                        android:textAppearance="@style/TextAppearance.AVORA.Body" />
                </LinearLayout>
            </LinearLayout>
            <!-- MANUEL SULAMA HIZLI ERİŞİMİ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWateringControlShortcut"
                style="@style/Widget.AVORA.Card.Main"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_ai_icon"
                        android:contentDescription="@string/menu_manual_watering_title"
                        android:padding="9dp"
                        android:src="@drawable/ic_water_drop_24"
                        app:tint="@color/info" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_manual_watering_title"
                            android:textColor="@color/textPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/menu_watering_control_description"
                            android:textAppearance="@style/TextAppearance.AVORA.Body" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/symbol_menu_arrow"
                        android:textColor="@color/textTertiary"
                        android:textSize="24sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- SULAMA AYARLARI -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Card.Main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_irrigation_title"
                        android:textAppearance="@style/TextAppearance.AVORA.CardTitle" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/settings_irrigation_subtitle"
                        android:textAppearance="@style/TextAppearance.AVORA.Body" />
                    <!-- NEM LİMİTİ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_moisture_limit"
                                android:textColor="@color/textPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/settings_moisture_limit_description"
                                android:textAppearance="@style/TextAppearance.AVORA.Body" />
                        </LinearLayout>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/primaryLight"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/primary"
                            app:strokeWidth="1dp">
                            <TextView
                                android:id="@+id/txtMoistureLimitValue"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/settings_default_percentage"
                                android:textColor="@color/primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMoistureLimit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:valueFrom="10"
                        android:valueTo="80"
                        android:stepSize="1"
                        android:value="40"
                        app:haloColor="@color/accentLight"
                        app:thumbColor="@color/primary"
                        app:trackColorActive="@color/primary"
                        app:trackColorInactive="@color/divider" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/divider" />
                    <!-- POMPA SÜRESİ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_pump_duration"
                                android:textColor="@color/textPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/settings_pump_duration_description"
                                android:textAppearance="@style/TextAppearance.AVORA.Body" />
                        </LinearLayout>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/infoBackground"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/info"
                            app:strokeWidth="1dp">
                            <TextView
                                android:id="@+id/txtPumpDurationValue"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/settings_default_seconds"
                                android:textColor="@color/info"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderPumpDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:valueFrom="0"
                        android:valueTo="18000"
                        android:stepSize="1"
                        android:value="10"
                        app:tickVisible="false"
                        app:haloColor="@color/infoBackground"
                        app:thumbColor="@color/info"
                        app:trackColorActive="@color/info"
                        app:trackColorInactive="@color/divider" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/divider" />
                    <!-- COOLDOWN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_cooldown"
                                android:textColor="@color/textPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/settings_cooldown_description"
                                android:textAppearance="@style/TextAppearance.AVORA.Body" />
                        </LinearLayout>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/warningBackground"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/warning"
                            app:strokeWidth="1dp">
                            <TextView
                                android:id="@+id/txtCooldownValue"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/settings_default_seconds"
                                android:textColor="@color/warning"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderCooldown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:valueFrom="300"
                        android:valueTo="3600"
                        android:stepSize="60"
                        android:value="600"
                        app:haloColor="@color/warningBackground"
                        app:thumbColor="@color/warning"
                        app:trackColorActive="@color/warning"
                        app:trackColorInactive="@color/divider" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/divider" />
                    <!-- RESTART DELTA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_restart_delta"
                                android:textColor="@color/textPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/settings_restart_delta_description"
                                android:textAppearance="@style/TextAppearance.AVORA.Body" />
                        </LinearLayout>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/primaryLight"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/primary"
                            app:strokeWidth="1dp">
                            <TextView
                                android:id="@+id/txtRestartDeltaValue"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/settings_default_percentage"
                                android:textColor="@color/primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRestartDelta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:valueFrom="1"
                        android:valueTo="30"
                        android:stepSize="1"
                        android:value="10"
                        app:haloColor="@color/accentLight"
                        app:thumbColor="@color/primary"
                        app:trackColorActive="@color/primary"
                        app:trackColorInactive="@color/divider" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/divider" />

                    <include layout="@layout/view_irrigation_restart_process" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/view_irrigation_timing_settings" />

            <include layout="@layout/view_manual_watering_safety_settings" />

            <!-- SİSTEM AYARLARI -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Card.Main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="82dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="0dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/irrigation_settings_auto_mode_title"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtAutoModeDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/irrigation_settings_auto_mode_active"
                                android:textAppearance="@style/TextAppearance.AVORA.Body" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAutoMode"
                            style="@style/Widget.AVORA.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/irrigation_settings_auto_mode_title" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="82dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="0dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_system_enabled"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtSystemEnabledDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/settings_system_enabled_description"
                                android:textAppearance="@style/TextAppearance.AVORA.Body" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSystemEnabled"
                            style="@style/Widget.AVORA.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/settings_system_enabled" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- VARSAYILANLAR VE OTOMATİK KAYIT DURUMU -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:text="@string/settings_reset_defaults"
                android:textAllCaps="false"
                android:textColor="@color/textSecondary"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp" />
            <TextView
                android:id="@+id/txtSettingsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/settings_status_ready"
                android:textAppearance="@style/TextAppearance.AVORA.Body" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        layout="@layout/include_primary_navigation" />
</FrameLayout>
