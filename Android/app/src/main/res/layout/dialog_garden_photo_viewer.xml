<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pagerGardenPhotos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="64dp"
        android:paddingBottom="124dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGardenPhotoViewerClose"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:text="@string/runtime_close"
        android:textAllCaps="false"
        android:textColor="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D9000000"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/runtime_photo_transform_hint"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtGardenPhotoPagerPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoRotateLeft"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/runtime_photo_rotate_left"
                android:minWidth="0dp"
                android:text="@string/symbol_rotate_left"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoRotateRight"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/runtime_photo_rotate_right"
                android:minWidth="0dp"
                android:text="@string/symbol_rotate_right"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoFlipHorizontal"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/runtime_photo_flip_horizontal"
                android:minWidth="0dp"
                android:text="@string/symbol_flip_horizontal"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoFlipVertical"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/runtime_photo_flip_vertical"
                android:minWidth="0dp"
                android:text="@string/symbol_flip_vertical"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoZoomOut"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/runtime_photo_zoom_out"
                android:minWidth="0dp"
                android:text="@string/symbol_zoom_out"
                android:textColor="@android:color/white"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoReset"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/runtime_photo_reset"
                android:minWidth="0dp"
                android:text="@string/symbol_photo_reset"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoZoomIn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/runtime_photo_zoom_in"
                android:minWidth="0dp"
                android:text="@string/symbol_zoom_in"
                android:textColor="@android:color/white"
                android:textSize="23sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
