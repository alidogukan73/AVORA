<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <include
        android:id="@+id/nasSecurityToolbar"
        layout="@layout/include_settings_toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/settings_toolbar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nasSecurityToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_screen_horizontal_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/settings_screen_horizontal_padding"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nas_security_intro"
                android:textAppearance="@style/TextAppearance.AVORA.Body" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressNasSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/primaryLight"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNasSecurityDisconnected"
                style="@style/Widget.AVORA.Card.Featured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.AVORA.Settings.IconBox"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="18dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nas_security_shield_24" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="@string/nas_security_not_connected_title"
                        android:textAppearance="@style/TextAppearance.AVORA.CardTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="@string/nas_security_not_connected_message"
                        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNasSecurityConnect"
                        style="@style/Widget.AVORA.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/data_sync_nas_account_connect" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNasSecurityRegister"
                        style="@style/Widget.AVORA.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/data_sync_nas_register_action" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutNasSecurityConnectedContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Card.Featured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.AVORA.Settings.IconBox"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="18dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nas_security_shield_24" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtNasSecurityAccountName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.AVORA.CardTitle"
                                tools:text="Ali Doğukan" />

                            <TextView
                                android:id="@+id/txtNasSecurityAccountEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle"
                                tools:text="alidogukan@gmail.com" />

                            <TextView
                                android:id="@+id/txtNasSecurityRole"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Yönetici hesap" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_nas_security_badge"
                            android:drawableStart="@drawable/ic_nas_security_check_16"
                            android:drawablePadding="5dp"
                            android:paddingStart="10dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="7dp"
                            android:text="@string/nas_security_safe"
                            android:textColor="@color/online"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/nas_security_connection"
                            android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nas_security_connected"
                            android:textColor="@color/online"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_section_spacing"
                android:layout_marginBottom="8dp"
                android:text="@string/nas_security_sessions_section"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.Category" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.AVORA.Settings.IconBox"
                            android:layout_width="44dp"
                            android:layout_height="44dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nas_security_devices_24" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/nas_security_this_device"
                                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowTitle" />

                            <TextView
                                android:id="@+id/txtNasSecurityThisDeviceDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/nas_security_this_device_detail"
                                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nas_security_active"
                            android:textColor="@color/online"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="56dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/nas_security_other_sessions_title"
                        android:textAppearance="@style/TextAppearance.AVORA.Settings.Category" />

                    <TextView
                        android:id="@+id/txtNasSecurityOtherSessionsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nas_security_sessions_checking"
                        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />

                    <LinearLayout
                        android:id="@+id/layoutNasSecurityOtherSessions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNasSecurityRevokeSessions"
                        style="@style/Widget.AVORA.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/data_sync_nas_revoke_others"
                        app:icon="@drawable/ic_nas_security_logout_24"
                        app:iconGravity="textStart"
                        app:iconTint="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_section_spacing"
                android:layout_marginBottom="8dp"
                android:text="@string/nas_security_family_section"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.Category" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNasSecurityAdministrator"
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.AVORA.Settings.IconBox"
                            android:layout_width="44dp"
                            android:layout_height="44dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nas_security_family_24" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/nas_security_family_accounts"
                                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowTitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/nas_security_family_detail"
                                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/nas_security_pending_label"
                            android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />

                        <TextView
                            android:id="@+id/txtNasSecurityPendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="İstek yok" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNasSecurityAccounts"
                        style="@style/Widget.AVORA.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/nas_security_view_accounts" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNasSecurityCreateInvite"
                        style="@style/Widget.AVORA.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/nas_security_create_invite_short"
                        app:icon="@drawable/ic_nas_security_add_person_24"
                        app:iconGravity="textStart"
                        app:iconTint="@color/textOnPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNasSecurityRequests"
                        style="@style/Widget.AVORA.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/nas_security_manage_requests" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNasSecurityMemberAccess"
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nas_security_garden_access"
                        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowTitle" />

                    <TextView
                        android:id="@+id/txtNasSecurityMemberAccessStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/nas_security_access_explanation"
                        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNasSecurityRequestAccess"
                        style="@style/Widget.AVORA.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/data_sync_nas_request_access" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_section_spacing"
                android:layout_marginBottom="8dp"
                android:text="@string/nas_security_account_section"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.Category" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowNasSecurityPassword"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nas_security_lock_24" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/data_sync_nas_change_password"
                                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowTitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/nas_security_password_detail"
                                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/textTertiary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/rowNasSecurityDetails"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nas_security_shield_24" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/nas_security_details_row"
                                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowTitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/nas_security_details_row_subtitle"
                                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right_24"
                            app:tint="@color/textTertiary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtNasSecurityOperationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.AVORA.Body"
                android:visibility="gone"
                tools:text="Güvenlik işlemi tamamlandı."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNasSecurityDisconnect"
                style="@style/Widget.AVORA.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="@string/data_sync_nas_account_disconnect"
                android:textColor="@color/error"
                app:icon="@drawable/ic_nas_security_logout_24"
                app:iconGravity="textStart"
                app:iconTint="@color/error"
                app:strokeColor="@color/error" />

            <TextView
                android:id="@+id/txtNasSecurityLastChecked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.AVORA.Supporting"
                tools:text="Son güvenlik kontrolü: Şimdi" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
