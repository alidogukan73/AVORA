<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aboutSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/aboutSettingsToolbar"
        layout="@layout/include_settings_toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/settings_toolbar_height"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/aboutSettingsToolbar"
        app:layout_constraintBottom_toTopOf="@id/aboutSettingsNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/settings_screen_horizontal_padding"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:contentDescription="@string/about_settings_app_icon_description"
                            android:src="@mipmap/ic_launcher"
                            android:scaleType="centerInside" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/app_name"
                                android:textColor="@color/textPrimary"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:id="@+id/txtAboutBrand" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/about_settings_brand_subtitle"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Body" />
                            <TextView
                                android:id="@+id/txtAppVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_about_version"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:text="@string/about_app_version_waiting"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/about_settings_overview_title"
                        android:textAppearance="@style/TextAppearance.AVORA.CardTitle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/about_settings_overview_message"
                        android:textAppearance="@style/TextAppearance.AVORA.About.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="@string/about_settings_features_category"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.Category"
                android:id="@+id/txtAboutFeaturesHeading" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_history_24"
                            app:tint="@color/primary"
                            android:background="@drawable/bg_about_icon"
                            android:padding="8dp"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_settings_feature_journal_title"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/about_settings_feature_journal"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Body" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_leaf_24"
                            app:tint="@color/primary"
                            android:background="@drawable/bg_about_icon"
                            android:padding="8dp"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_settings_feature_plant_title"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/about_settings_feature_plant"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Body" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_water_drop_24"
                            app:tint="@color/primary"
                            android:background="@drawable/bg_about_icon"
                            android:padding="8dp"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_settings_feature_irrigation_title"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/about_settings_feature_irrigation"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Body" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_journal_fertilizer_24"
                            app:tint="@color/primary"
                            android:background="@drawable/bg_about_icon"
                            android:padding="8dp"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_settings_feature_fertilizer_title"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/about_settings_feature_fertilizer"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Body" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_seedling_save_24"
                            app:tint="@color/primary"
                            android:background="@drawable/bg_about_icon"
                            android:padding="8dp"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_settings_feature_backup_title"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/about_settings_feature_backup"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Body" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="@string/about_settings_system_category"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.Category"
                android:id="@+id/txtAboutSystemHeading" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/about_settings_system_description"
                        android:textAppearance="@style/TextAppearance.AVORA.About.Body" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/txtSystemAppVersion"
                            android:text="@string/about_settings_app_version_label"
                            android:textAppearance="@style/TextAppearance.AVORA.About.Label" />
                        <TextView
                            android:id="@+id/txtSystemAppVersion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/about_app_version_waiting"
                            android:textIsSelectable="true"
                            android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/txtBackendVersion"
                            android:text="@string/about_settings_backend_version_label"
                            android:textAppearance="@style/TextAppearance.AVORA.About.Label" />
                        <TextView
                            android:id="@+id/txtBackendVersion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/about_settings_backend_waiting"
                            android:textIsSelectable="true"
                            android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/txtEsp32Version"
                            android:text="@string/about_settings_esp32_version_label"
                            android:textAppearance="@style/TextAppearance.AVORA.About.Label" />
                        <TextView
                            android:id="@+id/txtEsp32Version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/about_settings_backend_waiting"
                            android:textIsSelectable="true"
                            android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/txtNodeMcuVersion"
                            android:text="@string/about_settings_nodemcu_version_label"
                            android:textAppearance="@style/TextAppearance.AVORA.About.Label" />
                        <TextView
                            android:id="@+id/txtNodeMcuVersion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/about_settings_backend_waiting"
                            android:textIsSelectable="true"
                            android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/txtDeviceId"
                            android:text="@string/about_settings_device_label"
                            android:textAppearance="@style/TextAppearance.AVORA.About.Label" />
                        <TextView
                            android:id="@+id/txtDeviceId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/default_device_name"
                            android:textIsSelectable="true"
                            android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="@string/about_settings_developer_category"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.Category"
                android:id="@+id/txtAboutDeveloperHeading" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info_outline_20"
                            app:tint="@color/primary"
                            android:background="@drawable/bg_about_icon"
                            android:padding="10dp"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/txtDeveloperName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_developer_name"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Title" />
                            <TextView
                                android:id="@+id/txtDeveloperRole"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/about_developer_role"
                                android:textAppearance="@style/TextAppearance.AVORA.About.Body" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/about_settings_github_message"
                        android:textAppearance="@style/TextAppearance.AVORA.About.Body" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenGitHub"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="14dp"
                        android:paddingVertical="12dp"
                        android:text="@string/about_settings_github_button"
                        android:contentDescription="@string/about_settings_github_content_description"
                        android:textAllCaps="false"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/about_settings_footer"
                android:textAppearance="@style/TextAppearance.AVORA.About.Label" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/aboutSettingsNavigation"
        layout="@layout/include_primary_navigation"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
