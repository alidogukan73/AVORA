<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/plantTimelineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="94dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.AVORA.BackButton"
                    android:id="@+id/btnTimelineBack"
                    android:contentDescription="@string/notification_detail_back" />
                <TextView
                    android:id="@+id/txtTimelineTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/nav_plant_journal"
                    android:textAppearance="@style/TextAppearance.AVORA.CardTitle" />
                <TextView
                    android:id="@+id/btnTimelineMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:contentDescription="@string/timeline_menu_description"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="@string/symbol_more_options"
                    android:textColor="@color/textPrimary"
                    android:textSize="21sp" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/primaryDark"
                app:strokeWidth="1dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="14dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="11dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@id/txtTimelineEmoji"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtTimelineSeason"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_timeline_season_selector"
                            app:drawableEndCompat="@drawable/ic_expand_more_on_primary_18"
                            android:drawablePadding="5dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:minWidth="48dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:textColor="@color/card"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtTimelinePlanting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/accentLight"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/txtTimelineStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/card"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/txtTimelineEmoji"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center"
                        android:textSize="48sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tabTimeline"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/timeline_title"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tabPhotos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/photos_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tabNotes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/notes_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tabCompare"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/compare_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp" />
            </LinearLayout>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/filterTimelineAll"
                        android:layout_width="58dp"
                        android:layout_height="34dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surfaceGreen"
                        app:cardCornerRadius="17dp"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/filter_all"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/filterTimelineWatering"
                        android:layout_width="72dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/card"
                        app:cardCornerRadius="17dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/ui_timeline_irrigation"
                            android:textColor="@color/textPrimary"
                            android:textSize="11sp" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/filterTimelineFertilizer"
                        android:layout_width="66dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/card"
                        app:cardCornerRadius="17dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/ui_timeline_fertilization"
                            android:textColor="@color/textPrimary"
                            android:textSize="11sp" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/filterTimelineAnalysis"
                        android:layout_width="76dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/card"
                        app:cardCornerRadius="17dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/filter_ai_analysis"
                            android:textColor="@color/textPrimary"
                            android:textSize="11sp" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/filterTimelineEvent"
                        android:layout_width="58dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/card"
                        app:cardCornerRadius="17dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/filter_event"
                            android:textColor="@color/textPrimary"
                            android:textSize="11sp" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>
            <TextView
                android:id="@+id/txtTimelineMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.AVORA.CardTitle" />
            <LinearLayout
                android:id="@+id/layoutTimelineEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/txtTimelineEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:text="@string/timeline_empty"
                android:textAppearance="@style/TextAppearance.AVORA.Body" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTimelineAdd"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="88dp"
        android:text="@string/symbol_add"
        android:textSize="28sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="29dp" />
</FrameLayout>
