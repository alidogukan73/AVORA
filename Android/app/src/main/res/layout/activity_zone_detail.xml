<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.AVORA.BackButton"
                android:id="@+id/btnBack"
                android:contentDescription="@string/back_to_main" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtZoneDetailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zone_detail_title"
                    android:textAppearance="@style/TextAppearance.AVORA.ScreenTitle" />
                <TextView
                    android:id="@+id/txtZoneDetailSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/zone_detail_waiting"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZoneUnsavedChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/warningBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/warning"
            app:strokeWidth="1dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="@string/zone_unsaved_changes"
                android:textColor="@color/warning"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AVORA.Card.Main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zone_sensor_settings_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtZoneSensorId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchZoneSensor"
                    style="@style/Widget.AVORA.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/zone_sensor_enabled"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zone_sensor_enabled_description"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/zone_sensor_dry_raw_label">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputZoneSensorDryRaw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/zone_sensor_wet_raw_label">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputZoneSensorWetRaw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/zone_sensor_calibration_hint"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AVORA.Card.Main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchZoneIrrigation"
                    style="@style/Widget.AVORA.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/zone_irrigation_enabled"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtZoneIrrigationDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zone_irrigation_disabled_description"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/zone_moisture_limit"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtZoneMoistureLimitValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zone_default_percentage"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderZoneMoistureLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="40"
                    android:valueFrom="5"
                    android:valueTo="95"
                    android:stepSize="1"
                    app:haloColor="@color/accentLight"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary"
                    app:trackColorInactive="@color/divider" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/zone_pump_duration"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtZonePumpDurationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zone_default_seconds"
                    android:textColor="@color/info"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderZonePumpDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="10"
                    android:valueFrom="0"
                    android:valueTo="18000"
                    android:stepSize="1"
                    app:haloColor="@color/infoBackground"
                    app:thumbColor="@color/info"
                    app:tickVisible="false"
                    app:trackColorActive="@color/info"
                    app:trackColorInactive="@color/divider" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/zone_cooldown"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/zone_cooldown_description"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
                <TextView
                    android:id="@+id/txtZoneCooldownValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zone_default_minutes"
                    android:textColor="@color/warning"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderZoneCooldown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="4"
                    android:valueFrom="0"
                    android:valueTo="15"
                    android:stepSize="1"
                    app:haloColor="@color/warningBackground"
                    app:thumbColor="@color/warning"
                    app:tickVisible="false"
                    app:trackColorActive="@color/warning"
                    app:trackColorInactive="@color/divider" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/zone_restart_delta"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/zone_restart_delta_description"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
                <TextView
                    android:id="@+id/txtZoneRestartDeltaValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zone_default_restart_delta"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderZoneRestartDelta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="10"
                    android:valueFrom="1"
                    android:valueTo="30"
                    android:stepSize="1"
                    app:haloColor="@color/accentLight"
                    app:thumbColor="@color/primary"
                    app:trackColorActive="@color/primary"
                    app:trackColorInactive="@color/divider" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveZone"
                    style="@style/Widget.AVORA.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/zone_save_settings" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetZone"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/settings_reset_defaults"
                    android:textAllCaps="false"
                    android:textColor="@color/textSecondary"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp" />
                <TextView
                    android:id="@+id/txtZoneSettingsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/settings_status_ready"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AVORA.Card.Main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zone_valve_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtZoneValveMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/zone_valve_simulation"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/zone_test_safety_note"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestZoneValve"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/zone_test_simulation" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
