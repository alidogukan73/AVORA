<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AVORA.Settings.NavigationCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surfaceSoft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNasAccountAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="@color/primaryLight"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/txtNasAccountAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="AD" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNasAccountName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.AVORA.Settings.RowTitle"
                    tools:text="Ali Doğukan" />

                <TextView
                    android:id="@+id/txtNasAccountEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle"
                    tools:text="alidogukan@gmail.com" />

                <TextView
                    android:id="@+id/txtNasAccountCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_nas_security_badge"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="@string/nas_security_current_account"
                    android:textColor="@color/online"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtNasAccountRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_nas_account_role_admin"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:textColor="@color/primary"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="YÖNETİCİ" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNasAccountSession"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/online"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="● 2 aktif oturum" />

            <TextView
                android:id="@+id/txtNasAccountCreated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle"
                tools:text="Katıldı 12 Eyl 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtNasAccountLastActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle"
            tools:text="Son bağlantı: 13-09-2026 12:05" />

        <TextView
            android:id="@+id/txtNasAccountLifecycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/warning"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Veriler 13-10-2026 tarihine kadar korunuyor"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNasAccountReview"
            style="@style/Widget.AVORA.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="@string/nas_security_inactive_review_action"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNasAccountManage"
            style="@style/Widget.AVORA.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/nas_security_account_disable"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
