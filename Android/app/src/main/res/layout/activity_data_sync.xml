<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dataSyncRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/dataSyncToolbar"
        layout="@layout/include_settings_toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/settings_toolbar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/dataSyncNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dataSyncToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_screen_horizontal_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/settings_screen_horizontal_padding"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.QuickCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.AVORA.Settings.IconBox"
                        android:layout_width="44dp"
                        android:layout_height="44dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_restart" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/data_sync_intro_title"
                            android:textAppearance="@style/TextAppearance.AVORA.CardTitle" />

                        <TextView
                            android:id="@+id/txtDataSyncConnectionHeadline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/data_sync_intro_waiting"
                            android:textColor="@color/warning"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/data_sync_intro_message"
                            android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/data_sync_status_section"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.Category" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/layoutDataSyncValues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDataSyncNasSync"
                style="@style/Widget.AVORA.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="@string/data_sync_nas_two_way_button" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDataSyncNasAutomatic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/data_sync_nas_auto_title"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/data_sync_nas_auto_message"
                        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDataSyncNasPhotosAutomatic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/data_sync_nas_photo_auto_title"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/data_sync_nas_photo_auto_message"
                        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/data_sync_portable_backup_section"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.Category" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDataSyncPortableBackup"
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.AVORA.Settings.IconBox"
                        android:layout_width="44dp"
                        android:layout_height="44dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_history_24" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/data_sync_portable_backup_title"
                            android:textAppearance="@style/TextAppearance.AVORA.Settings.RowTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/data_sync_portable_backup_message"
                            android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/textSecondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/data_sync_automatic_section"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.Category" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.NavigationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDataSyncAutomatic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/data_sync_automatic_title"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/data_sync_automatic_message"
                        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/data_sync_transfer_section"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.Category" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Settings.QuickCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/data_sync_transfer_title"
                        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/data_sync_transfer_message"
                        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDataSyncNow"
                style="@style/Widget.AVORA.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:text="@string/data_sync_now" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressDataSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtDataSyncOperationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/dataSyncNavigation"
        layout="@layout/include_primary_navigation"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
