<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.AVORA.Card.Inner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTodayAdviceZone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.AVORA.CardTitle"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/txtTodayAdviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal" />
        </LinearLayout>
        <TextView
            android:id="@+id/txtTodayAdviceReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/fertilizerAdviceBody"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:textStyle="normal"
            android:lineSpacingExtra="2dp" />
        <TextView
            android:id="@+id/txtTodayAdviceContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textAppearance="@style/TextAppearance.AVORA.Supporting"
            android:textColor="@color/fertilizerAdviceSupporting"
            android:fontFamily="sans-serif"
            android:textStyle="normal" />
        <TextView
            android:id="@+id/txtTodayAdviceProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.AVORA.Body"
            android:textColor="@color/fertilizerAdviceBody"
            android:fontFamily="sans-serif"
            android:textStyle="normal" />
        <TextView
            android:id="@+id/txtTodayAdviceExperience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:textColor="@color/primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtTodayAdviceRisks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/warning"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/txtTodayAdviceOpenDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fertilizer_today_open_details"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="normal" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
