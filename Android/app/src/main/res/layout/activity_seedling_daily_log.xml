<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <FrameLayout
        android:id="@+id/seedlingDailyToolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/back_to_main"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_arrow_back_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/textPrimary"
            app:rippleColor="@color/backButtonRipple" />

        <TextView
            android:id="@+id/txtSeedlingDailyToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/seedling_daily_title"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeedlingDailyMore"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/seedling_more_options"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_more_vert_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/textPrimary"
            app:rippleColor="@color/backButtonRipple" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/seedlingDailyScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toTopOf="@id/btnSaveSeedlingLog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seedlingDailyToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeedlingDailyPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seedling_daily_photo_add"
                        android:textColor="@color/textPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/frameSeedlingDailyPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="172dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_doctor_photo_placeholder"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/imgSeedlingDailyPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/seedling_daily_photo_description"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layoutSeedlingDailyPhotoHint"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/symbol_camera"
                                android:textSize="34sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/seedling_daily_photo_hint"
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutSeedlingDailyPhotoActions"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSeedlingDailyPhotoChange"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="0dp"
                                android:text="@string/seedling_daily_photo_change"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSeedlingDailyPhotoDelete"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginStart="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="0dp"
                                android:text="@string/seedling_daily_photo_delete"
                                android:textColor="@color/offline"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Seedling.Card.Form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/seedling_height"
                            android:textAppearance="@style/TextAppearance.AVORA.Seedling.RowLabel" />
                        <LinearLayout android:layout_width="108dp" android:layout_height="match_parent"
                            android:gravity="center_vertical|end" android:orientation="horizontal">
                            <EditText android:id="@+id/inputSeedlingHeight" android:layout_width="0dp"
                                android:layout_height="match_parent" android:layout_weight="1"
                                android:background="@android:color/transparent" android:gravity="end|center_vertical"
                                android:hint="@string/seedling_decimal_zero" android:importantForAutofill="no"
                                android:inputType="numberDecimal" android:maxLines="1" android:padding="4dp"
                                android:selectAllOnFocus="true" android:textColor="@color/textPrimary"
                                android:textColorHint="@color/textTertiary" android:textSize="14sp" />
                            <TextView android:id="@+id/txtSeedlingHeightUnit"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="3dp" android:text="@string/seedling_cm_unit"
                                android:textColor="@color/textPrimary" android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/seedling_leaf_count"
                            android:textAppearance="@style/TextAppearance.AVORA.Seedling.RowLabel" />
                        <EditText android:id="@+id/inputSeedlingLeaves" android:layout_width="108dp"
                            android:layout_height="match_parent" android:background="@android:color/transparent"
                            android:gravity="end|center_vertical" android:hint="@string/seedling_zero"
                            android:importantForAutofill="no" android:inputType="number" android:maxLines="1"
                            android:padding="4dp" android:selectAllOnFocus="true" android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textTertiary" android:textSize="14sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/seedling_healthy_count"
                            android:textAppearance="@style/TextAppearance.AVORA.Seedling.RowLabel" />
                        <LinearLayout android:layout_width="122dp" android:layout_height="match_parent"
                            android:gravity="center_vertical|end" android:orientation="horizontal">
                            <EditText android:id="@+id/inputSeedlingHealthy" android:layout_width="0dp"
                                android:layout_height="match_parent" android:layout_weight="1"
                                android:background="@android:color/transparent" android:gravity="end|center_vertical"
                                android:hint="@string/seedling_zero" android:importantForAutofill="no"
                                android:inputType="number" android:maxLines="1" android:padding="4dp"
                                android:selectAllOnFocus="true" android:textColor="@color/textPrimary"
                                android:textColorHint="@color/textTertiary" android:textSize="14sp" />
                            <TextView android:id="@+id/txtSeedlingHealthyTotal" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginStart="3dp"
                                android:textColor="@color/textPrimary" android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/rowSeedlingWateringStatus"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/seedling_watered"
                            android:textAppearance="@style/TextAppearance.AVORA.Seedling.RowLabel" />
                        <TextView android:id="@+id/txtSeedlingWateredValue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/seedling_watering_not_done"
                            android:textColor="@color/textSecondary" android:textSize="14sp" android:textStyle="bold" />
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:layout_marginStart="7dp" android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_expand_more_20" app:tint="@color/primary" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp">
                        <TextView android:layout_width="96dp" android:layout_height="match_parent"
                            android:gravity="start|top" android:paddingTop="18dp" android:text="@string/seedling_note"
                            android:textAppearance="@style/TextAppearance.AVORA.Seedling.RowLabel" />
                        <EditText android:id="@+id/inputSeedlingNote" android:layout_width="0dp"
                            android:layout_height="match_parent" android:layout_weight="1"
                            android:background="@android:color/transparent" android:gravity="end|center_vertical"
                            android:hint="@string/seedling_daily_note_hint" android:importantForAutofill="no"
                            android:inputType="textCapSentences|textMultiLine" android:maxLines="3"
                            android:padding="6dp" android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textTertiary" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeedlingDailyWarning"
                style="@style/Widget.AVORA.Seedling.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/warningBackground"
                app:strokeColor="@color/warning">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:contentDescription="@null" app:srcCompat="@drawable/ic_seedling_warning_24" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/txtSeedlingDailyWarningTitle" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/seedling_daily_warning_stale_title"
                            android:textColor="@color/warning" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtSeedlingDailyWarningMessage" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="@string/seedling_daily_warning_stale_message"
                            android:textColor="@color/textSecondary" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeedlingDailyAdvice"
                style="@style/Widget.AVORA.Seedling.Card.Advice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:contentDescription="@null" app:srcCompat="@drawable/ic_info_outline_20" app:tint="@color/info" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/txtSeedlingDailyAdviceTitle" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/seedling_daily_advice_waiting_title"
                            android:textColor="@color/info" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtSeedlingDailyAdviceMessage" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="@string/seedling_daily_advice_waiting_message"
                            android:textColor="@color/textSecondary" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSeedlingLog"
        style="@style/Widget.AVORA.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:text="@string/seedling_save_log"
        android:textSize="16sp"
        app:cornerRadius="10dp"
        app:icon="@drawable/ic_seedling_save_24"
        app:iconGravity="textStart"
        app:iconSize="22dp"
        app:iconTint="@color/textOnPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
