<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="94dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.AVORA.BackButton"
                    android:id="@+id/btnDoctorBack" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fertilization_zone_assistant_action"
                        android:textColor="@color/textPrimary"
                        android:textSize="23sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/plant_assistant_subtitle"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/fertilization_zone_assistant_action"
                    android:src="@drawable/ic_plant_assistant_logo" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/aiPlantSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/aiPlantBorder"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="62dp"
                        android:layout_height="100dp"
                        android:contentDescription="@string/fertilization_zone_assistant_action"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_plant_assistant_robot" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fertilization_zone_assistant_action"
                            android:textColor="@color/aiPlantAccent"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/plant_assistant_intro"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reliability_title"
                            android:textColor="@color/textSecondary"
                            android:textSize="11sp" />
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="68dp"
                            android:layout_height="28dp"
                            android:layout_marginTop="3dp"
                            app:cardBackgroundColor="@color/warningBackground"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal"
                                tools:ignore="UseCompoundDrawables">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="@string/medium_reliability_description"
                                    android:src="@drawable/ic_shield_check_24" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:text="@string/adaptive_confidence_medium"
                                    android:textColor="@color/warning"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="5dp"
                        android:contentDescription="@string/info_description"
                        app:tint="@color/aiPlantAccent"
                        android:src="@drawable/ic_info_outline_20" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_photo_add_step"
                        android:textColor="@color/textPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <FrameLayout
                        android:id="@+id/cardDoctorPhotoPicker"
                        android:layout_width="match_parent"
                        android:layout_height="172dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_doctor_photo_placeholder"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:id="@+id/imgDoctorPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/garden_photo_content_description"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                        <LinearLayout
                            android:id="@+id/layoutDoctorPhotoHint"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/symbol_camera"
                                android:textSize="34sp" />
                            <TextView
                                android:id="@+id/txtDoctorPhotoHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/plant_assistant_no_photo"
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/card"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/plant_assistant_zone_step"
                                android:textColor="@color/textPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/zone_fallback_name"
                                android:textColor="@color/textSecondary"
                                android:textSize="11sp" />
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                app:endIconMode="dropdown_menu">
                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/dropdownDoctorZone"
                                    android:layout_width="match_parent"
                                    android:layout_height="64dp"
                                    android:ellipsize="end"
                                    android:focusable="false"
                                    android:gravity="center_vertical"
                                    android:inputType="none"
                                    android:maxLines="2"
                                    android:singleLine="false"
                                    android:textColor="@color/textPrimary"
                                    android:textSize="13sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="144dp"
                        android:layout_marginTop="12dp"
                        android:hint="@string/plant_assistant_description_hint"
                        app:hintTextColor="@color/textSecondary"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:counterEnabled="true"
                        app:counterMaxLength="250">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputDoctorNote"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:maxLength="250"
                            android:padding="12dp"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/textSecondary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            tools:ignore="UseCompoundDrawables">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/plant_assistant_symptoms_step"
                                android:textColor="@color/textPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:contentDescription="@string/symptom_info_description"
                                android:src="@drawable/ic_info_outline_20" />
                        </LinearLayout>
                        <CheckBox
                            android:id="@+id/checkDoctorGrowthStatus"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:layout_marginTop="7dp"
                            android:buttonTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="@string/plant_assistant_growth_status_option"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp" />
                        <CheckBox
                            android:id="@+id/checkDoctorYellowing"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:buttonTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="@string/symptom_yellowing"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp" />
                        <CheckBox
                            android:id="@+id/checkDoctorDrying"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:buttonTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="@string/symptom_drying"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp" />
                        <CheckBox
                            android:id="@+id/checkDoctorSpot"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:buttonTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="@string/symptom_spot"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp" />
                        <CheckBox
                            android:id="@+id/checkDoctorWilt"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:buttonTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="@string/ui_symptom_wilting"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp" />
                        <CheckBox
                            android:id="@+id/checkDoctorPest"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:buttonTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="@string/ui_symptom_fruit_cracking"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp" />
                        <CheckBox
                            android:id="@+id/checkDoctorFlowerDrop"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:buttonTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="@string/ui_symptom_flower_drop"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp" />
                        <CheckBox
                            android:id="@+id/checkDoctorOther"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:buttonTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="@string/symptom_other"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutDoctorOtherNote"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:hint="@string/symptom_other_hint"
                            app:hintTextColor="@color/textSecondary"
                            android:visibility="gone">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputDoctorOtherNote"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="top"
                                android:inputType="textMultiLine"
                                android:maxLength="120"
                                android:padding="8dp"
                                android:textColor="@color/textPrimary"
                                android:textColorHint="@color/textSecondary"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:hint="@string/plant_assistant_description_hint"
                app:counterEnabled="true"
                app:counterMaxLength="250">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputDoctorNoteLegacy"
                    android:layout_width="match_parent"
                    android:layout_height="94dp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:maxLength="250"
                    android:padding="12dp"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalyzePlant"
                style="@style/Widget.AVORA.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:text="@string/plant_assistant_start_analysis"
                android:textAllCaps="false"
                android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlantGrowthHistory"
                style="@style/Widget.AVORA.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:text="@string/runtime_growth_tracking_open"
                android:textAllCaps="false" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surfaceGreen"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plant_assistant_data_title"
                        android:textColor="@color/textPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/txtDoctorSoil"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/ui_assistant_soil_moisture"
                            android:textColor="@color/textPrimary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/txtDoctorWeatherTemp"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/weather_temperature_label"
                            android:textColor="@color/textPrimary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/txtDoctorSun"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/ui_assistant_sunlight"
                            android:textColor="@color/textPrimary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/txtDoctorWind"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/ui_assistant_wind"
                            android:textColor="@color/textPrimary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/txtDoctorHumidity"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/ui_assistant_air_humidity"
                            android:textColor="@color/textPrimary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/plant_assistant_last_analysis"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDoctorResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/txtDoctorTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtDoctorMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/warning"
                        android:textStyle="bold" />
                    <include layout="@layout/view_plant_growth_summary" />
                    <TextView
                        android:id="@+id/txtDoctorContext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtDoctorAdvice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/textPrimary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/plant_assistant_disclaimer"
                android:textColor="@color/textSecondary"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        layout="@layout/include_primary_navigation" />
</FrameLayout>
