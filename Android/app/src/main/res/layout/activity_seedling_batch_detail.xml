<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/seedlingDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <FrameLayout
        android:id="@+id/seedlingDetailToolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/back_to_main"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_arrow_back_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/textPrimary"
            app:rippleColor="@color/backButtonRipple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/seedling_detail_title"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeedlingMore"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/seedling_more_options"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_more_vert_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/textPrimary"
            app:rippleColor="@color/backButtonRipple" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/seedlingDetailScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toTopOf="@id/layoutSeedlingDetailActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seedlingDetailToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Seedling.Card"
                android:layout_width="match_parent"
                android:layout_height="80dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/txtSeedlingBatchEmoji"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:text="@string/symbol_seedling"
                        android:textSize="34sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtSeedlingBatchName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/textPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSeedlingBatchMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/textSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Seedling.Card.Status"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:padding="4dp"
                        app:srcCompat="@drawable/ic_seedling_plant_type_24"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/seedling_stage_heading"
                            android:textColor="@color/textSecondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtSeedlingStage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:maxLines="1"
                            android:textColor="@color/primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:contentDescription="@null"
                        android:padding="2dp"
                        app:srcCompat="@drawable/ic_seedling_stage_illustration_64" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutSeedlingTelemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/seedling_telemetry_heading"
                            android:textColor="@color/textPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSeedlingTargetContext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/textSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_seedling_target_chip"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="@string/seedling_crop_targets"
                        android:textColor="@color/primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSeedlingAirTemp"
                    style="@style/Widget.AVORA.Seedling.Card.Metric"
                    android:layout_width="0dp"
                    android:layout_height="146dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical" android:paddingHorizontal="4dp">
                        <ImageView android:id="@+id/imgSeedlingAirTemp" android:layout_width="26dp" android:layout_height="26dp"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_seedling_thermometer_24" />
                        <TextView android:layout_width="match_parent" android:layout_height="28dp"
                            android:gravity="center" android:maxLines="2" android:text="@string/seedling_metric_temperature"
                            android:textColor="@color/textSecondary" android:textSize="11sp" />
                        <TextView android:id="@+id/txtSeedlingAirTemp" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:gravity="center" android:text="@string/seedling_metric_empty"
                            android:textColor="@color/textPrimary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtSeedlingAirTempTarget" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center"
                            android:maxLines="1" android:textColor="@color/textSecondary" android:textSize="10sp" />
                        <TextView android:id="@+id/txtSeedlingAirTempState" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center"
                            android:maxLines="1" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSeedlingAirHumidity"
                    style="@style/Widget.AVORA.Seedling.Card.Metric"
                    android:layout_width="0dp"
                    android:layout_height="146dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical" android:paddingHorizontal="4dp">
                        <ImageView android:id="@+id/imgSeedlingAirHumidity" android:layout_width="26dp" android:layout_height="26dp"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_ai_water_drop_24" app:tint="@color/info" />
                        <TextView android:layout_width="match_parent" android:layout_height="28dp"
                            android:gravity="center" android:maxLines="2" android:text="@string/seedling_metric_humidity"
                            android:textColor="@color/textSecondary" android:textSize="11sp" />
                        <TextView android:id="@+id/txtSeedlingAirHumidity" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:gravity="center" android:text="@string/seedling_metric_empty"
                            android:textColor="@color/textPrimary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtSeedlingAirHumidityTarget" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center"
                            android:maxLines="1" android:textColor="@color/textSecondary" android:textSize="10sp" />
                        <TextView android:id="@+id/txtSeedlingAirHumidityState" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center"
                            android:maxLines="1" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSeedlingLight"
                    style="@style/Widget.AVORA.Seedling.Card.Metric"
                    android:layout_width="0dp"
                    android:layout_height="146dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical" android:paddingHorizontal="4dp">
                        <ImageView android:id="@+id/imgSeedlingLight" android:layout_width="26dp" android:layout_height="26dp"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_seedling_light_24" />
                        <TextView android:layout_width="match_parent" android:layout_height="28dp"
                            android:gravity="center" android:maxLines="2" android:text="@string/seedling_metric_light"
                            android:textColor="@color/textSecondary" android:textSize="11sp" />
                        <TextView android:id="@+id/txtSeedlingLight" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:gravity="center" android:text="@string/seedling_metric_empty"
                            android:textColor="@color/textPrimary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtSeedlingLightUnit" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:gravity="center" android:text="@string/seedling_lux_unit"
                            android:textColor="@color/textSecondary" android:textSize="9sp" />
                        <TextView android:id="@+id/txtSeedlingLightTarget" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="1dp" android:gravity="center"
                            android:maxLines="1" android:textColor="@color/textSecondary" android:textSize="10sp" />
                        <TextView android:id="@+id/txtSeedlingLightState" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center"
                            android:maxLines="1" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSeedlingRootTemp"
                    style="@style/Widget.AVORA.Seedling.Card.Metric"
                    android:layout_width="0dp"
                    android:layout_height="146dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical" android:paddingHorizontal="4dp">
                        <ImageView android:id="@+id/imgSeedlingRootTemp" android:layout_width="26dp" android:layout_height="26dp"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_seedling_soil_temperature_24" />
                        <TextView android:layout_width="match_parent" android:layout_height="28dp"
                            android:gravity="center" android:maxLines="2" android:text="@string/seedling_metric_soil_temperature"
                            android:textColor="@color/textSecondary" android:textSize="11sp" />
                        <TextView android:id="@+id/txtSeedlingRootTemp" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:gravity="center" android:text="@string/seedling_metric_empty"
                            android:textColor="@color/textPrimary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtSeedlingRootTempTarget" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center"
                            android:maxLines="1" android:textColor="@color/textSecondary" android:textSize="10sp" />
                        <TextView android:id="@+id/txtSeedlingRootTempState" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center"
                            android:maxLines="1" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSeedlingSoilMoisture"
                    style="@style/Widget.AVORA.Seedling.Card.Metric"
                    android:layout_width="0dp"
                    android:layout_height="146dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical" android:paddingHorizontal="4dp">
                        <ImageView android:id="@+id/imgSeedlingSoilMoisture" android:layout_width="26dp" android:layout_height="26dp"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_seedling_soil_moisture_24" />
                        <TextView android:layout_width="match_parent" android:layout_height="28dp"
                            android:gravity="center" android:maxLines="2" android:text="@string/seedling_metric_soil_moisture"
                            android:textColor="@color/textSecondary" android:textSize="11sp" />
                        <TextView android:id="@+id/txtSeedlingSoilMoisture" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:gravity="center" android:text="@string/seedling_metric_empty"
                            android:textColor="@color/textPrimary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtSeedlingSoilMoistureTarget" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center"
                            android:maxLines="1" android:textColor="@color/textSecondary" android:textSize="10sp" />
                        <TextView android:id="@+id/txtSeedlingSoilMoistureState" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center"
                            android:maxLines="1" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtSeedlingNoTelemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_seedling_empty_card"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/seedling_no_telemetry"
                android:textAppearance="@style/TextAppearance.AVORA.Supporting" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/seedling_timeline_heading"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="8dp">
                <androidx.constraintlayout.widget.Guideline android:id="@+id/guideSeedlingStage0"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" app:layout_constraintGuide_percent="0.1" />
                <androidx.constraintlayout.widget.Guideline android:id="@+id/guideSeedlingStage1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" app:layout_constraintGuide_percent="0.3" />
                <androidx.constraintlayout.widget.Guideline android:id="@+id/guideSeedlingStage2"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" app:layout_constraintGuide_percent="0.5" />
                <androidx.constraintlayout.widget.Guideline android:id="@+id/guideSeedlingStage3"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" app:layout_constraintGuide_percent="0.7" />
                <androidx.constraintlayout.widget.Guideline android:id="@+id/guideSeedlingStage4"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" app:layout_constraintGuide_percent="0.9" />
                <View android:id="@+id/viewSeedlingStageLine0" android:layout_width="0dp" android:layout_height="2dp"
                    android:background="@color/divider" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guideSeedlingStage1"
                    app:layout_constraintStart_toStartOf="@id/guideSeedlingStage0"
                    app:layout_constraintTop_toTopOf="parent" />
                <View android:id="@+id/viewSeedlingStageLine1" android:layout_width="0dp" android:layout_height="2dp"
                    android:background="@color/divider" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guideSeedlingStage2"
                    app:layout_constraintStart_toStartOf="@id/guideSeedlingStage1"
                    app:layout_constraintTop_toTopOf="parent" />
                <View android:id="@+id/viewSeedlingStageLine2" android:layout_width="0dp" android:layout_height="2dp"
                    android:background="@color/divider" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guideSeedlingStage3"
                    app:layout_constraintStart_toStartOf="@id/guideSeedlingStage2"
                    app:layout_constraintTop_toTopOf="parent" />
                <View android:id="@+id/viewSeedlingStageLine3" android:layout_width="0dp" android:layout_height="2dp"
                    android:background="@color/divider" app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guideSeedlingStage4"
                    app:layout_constraintStart_toStartOf="@id/guideSeedlingStage3"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/txtSeedlingStageNode0" android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/bg_seedling_stage_done" android:gravity="center" android:text="✓"
                    android:textColor="@color/textOnPrimary" android:textSize="13sp" android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="@id/guideSeedlingStage0"
                    app:layout_constraintStart_toStartOf="@id/guideSeedlingStage0" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/txtSeedlingStageNode1" android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/bg_seedling_stage_pending" android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="@id/guideSeedlingStage1"
                    app:layout_constraintStart_toStartOf="@id/guideSeedlingStage1" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/txtSeedlingStageNode2" android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/bg_seedling_stage_pending" android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="@id/guideSeedlingStage2"
                    app:layout_constraintStart_toStartOf="@id/guideSeedlingStage2" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/txtSeedlingStageNode3" android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/bg_seedling_stage_pending" android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="@id/guideSeedlingStage3"
                    app:layout_constraintStart_toStartOf="@id/guideSeedlingStage3" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/txtSeedlingStageNode4" android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/bg_seedling_stage_pending" android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="@id/guideSeedlingStage4"
                    app:layout_constraintStart_toStartOf="@id/guideSeedlingStage4" app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:gravity="top|center_horizontal" android:includeFontPadding="false" android:maxLines="2"
                    android:text="@string/seedling_stage_sowing" android:textAlignment="center" android:textColor="@color/textPrimary" android:textSize="10sp" />
                <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:gravity="top|center_horizontal" android:includeFontPadding="false" android:maxLines="2"
                    android:text="@string/seedling_stage_germination" android:textAlignment="center" android:textColor="@color/textPrimary" android:textSize="10sp" />
                <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:gravity="top|center_horizontal" android:includeFontPadding="false" android:maxLines="2"
                    android:text="@string/seedling_stage_first_leaf" android:textAlignment="center" android:textColor="@color/textPrimary" android:textSize="10sp" />
                <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:gravity="top|center_horizontal" android:includeFontPadding="false" android:maxLines="2"
                    android:text="@string/seedling_stage_transplant" android:textAlignment="center" android:textColor="@color/textPrimary" android:textSize="10sp" />
                <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:gravity="top|center_horizontal" android:includeFontPadding="false" android:maxLines="2"
                    android:text="@string/seedling_stage_ready" android:textAlignment="center" android:textColor="@color/textPrimary" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/txtSeedlingStageDate0" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:textColor="@color/textPrimary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtSeedlingStageDate1" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:textColor="@color/textPrimary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtSeedlingStageDate2" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:textColor="@color/textPrimary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtSeedlingStageDate3" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:textColor="@color/textPrimary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtSeedlingStageDate4" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:textColor="@color/textPrimary" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeedlingFertilizerGuide"
                style="@style/Widget.AVORA.Seedling.Card.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_fertilization_24"
                            app:tint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/seedling_fertilizer_title"
                                android:textColor="@color/primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtSeedlingFertilizerContext"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/textSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="@string/seedling_fertilizer_type_label"
                        android:textColor="@color/textPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSeedlingFertilizerType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/textPrimary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:text="@string/seedling_fertilizer_application_label"
                        android:textColor="@color/textPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSeedlingFertilizerApplication"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:text="@string/seedling_fertilizer_crop_note_label"
                        android:textColor="@color/textPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSeedlingFertilizerCropNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_seedling_target_chip"
                        android:lineSpacingExtra="2dp"
                        android:padding="10dp"
                        android:text="@string/seedling_fertilizer_safety"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="end"
                        android:text="@string/seedling_fertilizer_research_note"
                        android:textColor="@color/textSecondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeedlingOverallStatus"
                style="@style/Widget.AVORA.Seedling.Card.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                    <TextView android:id="@+id/txtSeedlingOverallIcon" android:layout_width="28dp" android:layout_height="28dp"
                        android:background="@drawable/bg_seedling_stage_done" android:gravity="center" android:text="✓"
                        android:textColor="@color/textOnPrimary" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/txtSeedlingOverallTitle" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/seedling_overall_waiting"
                            android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtSeedlingOverallMessage" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="@string/seedling_overall_waiting_message" android:textColor="@color/textSecondary" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeedlingAdvice"
                style="@style/Widget.AVORA.Seedling.Card.Advice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:contentDescription="@null" app:srcCompat="@drawable/ic_info_outline_20" app:tint="@color/info" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/txtSeedlingAdviceTitle" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/seedling_advice_waiting"
                            android:textColor="@color/info" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtSeedlingAdviceMessage" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:textColor="@color/textSecondary" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/seedling_logs_heading"
                android:textAppearance="@style/TextAppearance.AVORA.CardTitle" />

            <TextView
                android:id="@+id/txtSeedlingLogsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_seedling_empty_card"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/seedling_no_logs"
                android:textAppearance="@style/TextAppearance.AVORA.Body" />

            <LinearLayout
                android:id="@+id/layoutSeedlingLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutSeedlingDetailActions"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeedlingDailyLog"
            style="@style/Widget.AVORA.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/seedling_daily_record"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_seedling_edit_20"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeedlingAdvance"
            style="@style/Widget.AVORA.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="@string/seedling_advance_stage"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_leaf_24"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/textOnPrimary" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
