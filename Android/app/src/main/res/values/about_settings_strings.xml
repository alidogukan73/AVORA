    <string name="about_settings_app_icon_description">AVORA uygulama logosu</string>
    <string name="about_settings_overview_title">Fideden hasada, bahçenizle birlikte.</string>
    <string name="about_settings_overview_message">AVORA; bitki gelişimini, sulamayı ve gübrelemeyi tek yerde takip etmenizi sağlar. Sensör verilerini, fotoğrafları ve bakım geçmişini bir araya getirerek günlük bakım kararlarınıza destek olur.</string>
    <string name="about_settings_features_category">Öne çıkan özellikler</string>
    <string name="about_settings_feature_journal_title">Bitki Günlüğü</string>
    <string name="about_settings_feature_journal">Fotoğraf, gözlem ve önemli gelişmeleri sezon bazında kaydedin. + menüsünden manuel sulama ve gübreleme ekranlarına ulaşın.</string>
    <string name="about_settings_feature_plant_title">Bitki ve fide asistanları</string>
    <string name="about_settings_feature_plant">Bitki fotoğraflarını bahçe verileriyle birlikte değerlendirin. Fide partilerini ekimden sezona aktarıma kadar takip edin.</string>
    <string name="about_settings_feature_irrigation_title">Bölgesel sulama</string>
    <string name="about_settings_feature_irrigation">Toprak nemini izleyin; manuel ve otomatik sulamayı yönetin. Tamamlanan işlemleri ve sonuçlarını geçmişte inceleyin.</string>
    <string name="about_settings_feature_fertilizer_title">Gübreleme ve stok takibi</string>
    <string name="about_settings_feature_fertilizer">Gübre önerilerini, ürün stoklarını ve uygulama takvimini takip edin. Yaptığınız uygulamaları ve sonuçlarını kaydedin.</string>
    <string name="about_settings_feature_backup_title">Senkronizasyon ve yedekleme</string>
    <string name="about_settings_feature_backup">Verileri NAS ile eşitleyin; veri ve fotoğraf yedeklerini yönetin. Hesap ve cihaz erişimlerini ayarlardan kontrol edin.</string>
    <string name="about_settings_system_category">Sürüm ve cihaz bilgileri</string>
    <string name="about_settings_system_description">Sistem sürümleri, cihazların son bildirdiği bilgilerden alınır.</string>
