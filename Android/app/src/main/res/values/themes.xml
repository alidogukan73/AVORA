<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========================================================= -->
    <!-- ANA UYGULAMA TEMASI                                       -->
    <!-- ========================================================= -->
    <style
        name="Base.Theme.AVORA"
        parent="Theme.Material3.DayNight.NoActionBar">
        <!-- MARKA RENKLERİ -->
        <item
            name="colorPrimary">@color/primary</item>
        <item
            name="colorOnPrimary">@color/textOnPrimary</item>
        <item
            name="colorPrimaryContainer">@color/primaryLight</item>
        <item
            name="colorOnPrimaryContainer">@color/primaryDark</item>
        <item
            name="colorSecondary">@color/accent</item>
        <item
            name="colorOnSecondary">@color/textOnPrimary</item>
        <item
            name="colorSecondaryContainer">@color/accentLight</item>
        <item
            name="colorOnSecondaryContainer">@color/primaryDark</item>
        <!-- ARKA PLAN VE YÜZEYLER -->
        <item
            name="android:colorBackground">@color/background</item>
        <item
            name="colorOnBackground">@color/textPrimary</item>
        <item
            name="colorSurface">@color/card</item>
        <item
            name="colorOnSurface">@color/textPrimary</item>
        <item
            name="colorSurfaceVariant">@color/surfaceSoft</item>
        <item
            name="colorOnSurfaceVariant">@color/textSecondary</item>
        <item
            name="colorOutline">@color/border</item>
        <item
            name="colorOutlineVariant">@color/divider</item>
        <!-- DURUM ÇUBUKLARI -->
        <item
            name="android:statusBarColor">@color/background</item>
        <item
            name="android:navigationBarColor">@color/background</item>
        <item
            name="android:windowLightStatusBar">true</item>
        <!-- PENCERE DAVRANIŞI -->
        <item
            name="android:windowActionModeOverlay">true</item>
        <item
            name="android:windowNoTitle">true</item>
        <item
            name="android:fontFamily">sans</item>
        <item
            name="fontFamily">sans</item>
        <!-- VARSAYILAN BİLEŞEN STİLLERİ -->
        <item
            name="materialCardViewStyle"> @style/Widget.AVORA.Card.Main </item>
        <item
            name="materialButtonStyle"> @style/Widget.AVORA.Button.Primary </item>
        <item
            name="switchStyle"> @style/Widget.AVORA.Switch </item>
    </style>


    <!-- UYGULAMANIN KULLANDIĞI TEMA -->
    <style
        name="Theme.AVORA"
        parent="Base.Theme.AVORA" />
    <!-- ========================================================= -->
    <!-- KART STİLLERİ                                             -->
    <!-- ========================================================= -->
    <style
        name="Widget.AVORA.Card.Main"
        parent="Widget.Material3.CardView.Elevated">
        <item
            name="cardBackgroundColor">@color/card</item>
        <item
            name="cardCornerRadius">22dp</item>
        <item
            name="cardElevation">1dp</item>
        <item
            name="strokeColor">@color/border</item>
        <item
            name="strokeWidth">1dp</item>
    </style>
    <style
        name="Widget.AVORA.Card.Featured"
        parent="Widget.Material3.CardView.Elevated">
        <item
            name="cardBackgroundColor">@color/card</item>
        <item
            name="cardCornerRadius">22dp</item>
        <item
            name="cardElevation">1dp</item>
        <item
            name="strokeColor">@color/primary</item>
        <item
            name="strokeWidth">1dp</item>
    </style>
    <style
        name="Widget.AVORA.Card.Inner"
        parent="Widget.Material3.CardView.Filled">
        <item
            name="cardBackgroundColor">@color/surfaceSoft</item>
        <item
            name="cardCornerRadius">16dp</item>
        <item
            name="cardElevation">0dp</item>
        <item
            name="strokeColor">@color/border</item>
        <item
            name="strokeWidth">1dp</item>
    </style>
    <style
        name="Widget.AVORA.Card.Success"
        parent="Widget.Material3.CardView.Filled">
        <item
            name="cardBackgroundColor">@color/onlineBackground</item>
        <item
            name="cardCornerRadius">16dp</item>
        <item
            name="cardElevation">0dp</item>
        <item
            name="strokeColor">@color/online</item>
        <item
            name="strokeWidth">1dp</item>
    </style>
    <!-- ========================================================= -->
    <!-- BUTON STİLLERİ                                            -->
    <!-- ========================================================= -->
    <style
        name="Widget.AVORA.Button.Primary"
        parent="Widget.Material3.Button">
        <item
            name="android:layout_height">58dp</item>
        <item
            name="backgroundTint">@color/buttonStart</item>
        <item
            name="android:textColor">@color/textOnPrimary</item>
        <item
            name="android:textSize">15sp</item>
        <item
            name="android:textStyle">bold</item>
        <item
            name="android:textAllCaps">false</item>
        <item
            name="cornerRadius">18dp</item>
        <item
            name="android:insetTop">0dp</item>
        <item
            name="android:insetBottom">0dp</item>
        <item
            name="android:minHeight">0dp</item>
        <item
            name="elevation">0dp</item>
        <item
            name="rippleColor">#40FFFFFF</item>
    </style>
    <style
        name="Widget.AVORA.Button.Outlined"
        parent="Widget.Material3.Button">
        <item
            name="android:layout_height">52dp</item>
        <item
            name="backgroundTint">@android:color/transparent</item>
        <item
            name="android:textColor">@color/primary</item>
        <item
            name="android:textSize">14sp</item>
        <item
            name="android:textStyle">bold</item>
        <item
            name="android:textAllCaps">false</item>
        <item
            name="cornerRadius">18dp</item>
        <item
            name="strokeColor">@color/primary</item>
        <item
            name="strokeWidth">1dp</item>
        <item
            name="android:insetTop">0dp</item>
        <item
            name="android:insetBottom">0dp</item>
        <item
            name="android:minHeight">0dp</item>
        <item
            name="elevation">0dp</item>
    </style>
    <!-- ========================================================= -->
    <!-- SWITCH STİLİ                                              -->
    <!-- ========================================================= -->
    <style
        name="Widget.AVORA.Switch"
        parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item
            name="thumbTint">@color/switch_thumb_selector</item>
        <item
            name="trackTint">@color/switch_track_selector</item>
        <item
            name="android:minWidth">52dp</item>
        <item
            name="android:minHeight">32dp</item>
    </style>
    <!-- ========================================================= -->
    <!-- METİN STİLLERİ                                            -->
    <!-- ========================================================= -->
    <style
        name="TextAppearance.AVORA.ScreenTitle"
        parent="TextAppearance.Material3.HeadlineSmall">
        <item
            name="android:textColor">@color/textPrimary</item>
        <item
            name="android:textSize">24sp</item>
        <item
            name="android:textStyle">bold</item>
    </style>
    <style
        name="TextAppearance.AVORA.CardTitle"
        parent="TextAppearance.Material3.TitleMedium">
        <item
            name="android:textColor">@color/textPrimary</item>
        <item
            name="android:textSize">18sp</item>
        <item
            name="android:textStyle">bold</item>
    </style>
    <style
        name="TextAppearance.AVORA.Body"
        parent="TextAppearance.Material3.BodyMedium">
        <item
            name="android:textColor">@color/textSecondary</item>
        <item
            name="android:textSize">13sp</item>
    </style>
    <style
        name="TextAppearance.AVORA.Label"
        parent="TextAppearance.Material3.LabelMedium">
        <item
            name="android:textColor">@color/textSecondary</item>
        <item
            name="android:textSize">11sp</item>
        <item
            name="android:textStyle">bold</item>
    </style>
    <style
        name="TextAppearance.AVORA.Value"
        parent="TextAppearance.Material3.TitleLarge">
        <item
            name="android:textColor">@color/textPrimary</item>
        <item
            name="android:textSize">18sp</item>
        <item
            name="android:textStyle">bold</item>
    </style>
    <!-- ========================================================= -->
    <!-- AVORA DESIGN SYSTEM EK STİLLERİ                    -->
    <!-- ========================================================= -->
    <!-- Küçük bölüm başlığı -->
    <!-- Büyük gösterge değeri -->
    <!-- Kart içi yardımcı açıklama -->
    <style
        name="TextAppearance.AVORA.Supporting"
        parent="TextAppearance.Material3.BodySmall">
        <item
            name="android:textColor">@color/textSecondary</item>
        <item
            name="android:textSize">11sp</item>
        <item
            name="android:lineSpacingExtra">2dp</item>
    </style>
    <!-- Durum rozeti metni -->
    <!-- İkincil buton -->
    <style
        name="Widget.AVORA.Button.Secondary"
        parent="Widget.Material3.Button.OutlinedButton">
        <item
            name="android:layout_height">52dp</item>
        <item
            name="android:textColor">@color/primary</item>
        <item
            name="android:textSize">14sp</item>
        <item
            name="android:textStyle">bold</item>
        <item
            name="android:textAllCaps">false</item>
        <item
            name="strokeColor">@color/primary</item>
        <item
            name="strokeWidth">1dp</item>
        <item
            name="cornerRadius">16dp</item>
        <item
            name="android:insetTop">0dp</item>
        <item
            name="android:insetBottom">0dp</item>
        <item
            name="android:minHeight">0dp</item>
        <item
            name="rippleColor">@color/primaryLight</item>
    </style>
    <!-- Tehlikeli işlem butonu -->
    <!-- Küçük ikon butonu -->
    <style
        name="Widget.AVORA.Button.Icon"
        parent="Widget.Material3.Button.IconButton">
        <item
            name="android:layout_width">44dp</item>
        <item
            name="android:layout_height">44dp</item>
        <item
            name="android:minWidth">0dp</item>
        <item
            name="android:minHeight">0dp</item>
        <item
            name="android:insetTop">0dp</item>
        <item
            name="android:insetBottom">0dp</item>
        <item
            name="backgroundTint">@android:color/transparent</item>
        <item
            name="rippleColor">@color/accentLight</item>
        <item
            name="cornerRadius">22dp</item>
    </style>
    <!-- Tüm ekranlarda kullanılan tek tip geri düğmesi. -->
    <style
        name="Widget.AVORA.BackButton"
        parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:contentDescription">@string/back_to_main</item>
        <item name="backgroundTint">@color/backButtonSurface</item>
        <item name="cornerRadius">22dp</item>
        <item name="rippleColor">@color/backButtonRipple</item>
        <item name="icon">@drawable/ic_arrow_back_24</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/backButtonIcon</item>
    </style>    <!-- Dashboard küçük iç kartı -->
    <style
        name="Widget.AVORA.Card.Metric"
        parent="Widget.Material3.CardView.Filled">
        <item
            name="cardBackgroundColor">@color/surfaceSoft</item>
        <item
            name="cardCornerRadius">16dp</item>
        <item
            name="cardElevation">0dp</item>
        <item
            name="strokeColor">@color/border</item>
        <item
            name="strokeWidth">1dp</item>
    </style>
    <!-- Düz liste kartı -->
    <!-- Bilgi kartı -->
    <style
        name="Widget.AVORA.Card.Info"
        parent="Widget.Material3.CardView.Filled">
        <item
            name="cardBackgroundColor">@color/infoBackground</item>
        <item
            name="cardCornerRadius">16dp</item>
        <item
            name="cardElevation">0dp</item>
        <item
            name="strokeColor">@color/info</item>
        <item
            name="strokeWidth">1dp</item>
    </style>
    <!-- Uyarı kartı -->
    <!-- Yuvarlak ikon görünümü -->
    <!-- Uygulamadaki bütün geri düğmelerinin tek ortak görünümü -->
    <style name="Widget.AVORA.Seedling.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.AVORA.Seedling.Card.Metric" parent="Widget.AVORA.Seedling.Card">
        <item name="cardCornerRadius">13dp</item>
    </style>
    <style name="Widget.AVORA.Seedling.Card.Status" parent="Widget.AVORA.Seedling.Card">
        <item name="cardBackgroundColor">@color/surfaceGreen</item>
        <item name="strokeColor">@color/accentLight</item>
    </style>
    <style name="Widget.AVORA.Seedling.Card.Form" parent="Widget.AVORA.Seedling.Card">
        <item name="cardCornerRadius">16dp</item>
    </style>
    <style name="Widget.AVORA.Seedling.Card.Advice" parent="Widget.AVORA.Seedling.Card">
        <item name="cardBackgroundColor">@color/infoBackground</item>
        <item name="strokeColor">@color/info</item>
    </style>
    <style name="TextAppearance.AVORA.Seedling.RowLabel" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.AVORA.Seedling.Metric" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
