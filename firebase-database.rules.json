{
  "rules": {
    ".read": false,
    ".write": false,
    "device_access": {
      "$deviceId": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || auth.token.avora_device_id == $deviceId)",
          ".write": "auth != null && auth.token.avora_device_id == $deviceId",
          ".validate": "!newData.exists() || (newData.hasChildren(['approved', 'firebase_uid', 'nas_user_id', 'email', 'display_name', 'approved_by', 'approved_at']) && newData.child('approved').val() == true && newData.child('firebase_uid').val() == $uid && newData.child('approved_by').val() == auth.uid)",
          "approved": {
            ".validate": "newData.isBoolean() && newData.val() == true"
          },
          "firebase_uid": {
            ".validate": "newData.isString() && newData.val() == $uid && newData.val().matches(/^[A-Za-z0-9_-]{16,128}$/)"
          },
          "nas_user_id": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9a-fA-F-]{36}$/)"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 254"
          },
          "display_name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "approved_by": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "approved_at": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "access_request_notifications": {
      "$deviceId": {
        "$uid": {
          ".read": false,
          ".write": "auth != null && auth.uid == $uid && (!data.exists() || data.child('requested_at_epoch').val() <= now - 120000)",
          ".validate": "newData.hasChildren(['request_id', 'firebase_uid', 'requested_at_epoch', 'source']) && newData.child('firebase_uid').val() == auth.uid",
          "request_id": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9a-fA-F-]{36}$/)"
          },
          "firebase_uid": {
            ".validate": "newData.isString() && newData.val() == $uid && newData.val().matches(/^[A-Za-z0-9_-]{16,128}$/)"
          },
          "requested_at_epoch": {
            ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 5000"
          },
          "source": {
            ".validate": "newData.isString() && newData.val() == 'android'"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "superadmin_devices": {
      "$deviceId": {
        ".read": "auth != null && auth.token.avora_device_id == $deviceId",
        "commands": {
          ".indexOn": [
            "status",
            "completed_at_epoch"
          ],
          "$commandId": {
            ".write": "auth != null && auth.token.avora_device_id == $deviceId && !data.exists()",
            ".validate": "newData.hasChildren(['id', 'operation', 'category', 'record_id', 'requested_by_uid', 'requested_at', 'expires_at', 'source', 'status']) && ((newData.child('operation').val() == 'update' && newData.child('replacement_json').exists() && newData.child('expected_record_json').exists() && !newData.child('backup_id').exists() && !newData.child('preview_token').exists()) || (newData.child('operation').val() == 'delete' && newData.child('preview_token').exists() && !newData.child('replacement_json').exists() && !newData.child('expected_record_json').exists() && !newData.child('backup_id').exists()) || (newData.child('operation').val() == 'delete_feedback' && newData.child('category').val() == 'feedback' && !newData.child('preview_token').exists() && !newData.child('replacement_json').exists() && !newData.child('expected_record_json').exists() && !newData.child('backup_id').exists()) || (newData.child('operation').val() == 'preview_delete' && !newData.child('preview_token').exists() && !newData.child('replacement_json').exists() && !newData.child('expected_record_json').exists() && !newData.child('backup_id').exists()) || (newData.child('operation').val() == 'restore' && newData.child('backup_id').exists() && !newData.child('replacement_json').exists() && !newData.child('expected_record_json').exists() && !newData.child('preview_token').exists()))",
            "id": {
              ".validate": "newData.isString() && newData.val() == $commandId && newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)"
            },
            "operation": {
              ".validate": "newData.isString() && (newData.val() == 'preview_delete' || newData.val() == 'delete' || newData.val() == 'delete_feedback' || newData.val() == 'update' || newData.val() == 'restore')"
            },
            "category": {
              ".validate": "newData.isString() && (newData.val() == 'zones' || newData.val() == 'seasons' || newData.val() == 'seedling_batches' || newData.val() == 'journal_events' || newData.val() == 'photos' || newData.val() == 'watering' || newData.val() == 'fertilizer' || newData.val() == 'notifications' || newData.val() == 'feedback')"
            },
            "record_id": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180 && !newData.val().matches(/.*[.\\/#$\\[\\]].*/)"
            },
            "replacement_json": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 131072"
            },
            "expected_record_json": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 131072"
            },
            "backup_id": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)"
            },
            "preview_token": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
            },
            "requested_by_uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "requested_at": {
              ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 5000"
            },
            "expires_at": {
              ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 300000"
            },
            "source": {
              ".validate": "newData.isString() && newData.val() == 'android'"
            },
            "status": {
              ".validate": "newData.isString() && newData.val() == 'pending'"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "audit": {
          ".indexOn": "completed_at_epoch",
          ".write": false
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "devices": {
      "$deviceId": {
        ".read": "auth != null && (auth.token.avora_device_id == $deviceId || root.child('device_access').child($deviceId).child(auth.uid).child('approved').val() == true)",
        ".write": "auth != null && (auth.token.avora_device_id == $deviceId || (root.child('device_access').child($deviceId).child(auth.uid).child('approved').val() == true && newData.child('superadmin').val() == data.child('superadmin').val())) && newData.child('user_feedback_email_state/activation_epoch').val() == data.child('user_feedback_email_state/activation_epoch').val() && (auth.token.avora_device_id == $deviceId || newData.child('weather/irrigation_settings/manual_watering_max_duration_seconds').val() == data.child('weather/irrigation_settings/manual_watering_max_duration_seconds').val()) && newData.child('user_feedback').val() == data.child('user_feedback').val()",
        "user_feedback_email_state": {
          "activation_epoch": {
            ".validate": "newData.val() == data.val()"
          },
          "$other": {
            ".validate": false
          }
        },
        "commands": {
          "network_configuration": {
            ".validate": "newData.hasChildren(['requested', 'request_id', 'interface', 'mode', 'ip_address', 'prefix_length', 'gateway', 'primary_dns', 'secondary_dns', 'requested_at', 'expires_at', 'source'])",
            "requested": {
              ".validate": "newData.isBoolean() && newData.val() == true"
            },
            "request_id": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)"
            },
            "interface": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32 && newData.val() != 'lo' && newData.val().matches(/^[A-Za-z0-9_.:-]+$/)"
            },
            "mode": {
              ".validate": "newData.isString() && (newData.val() == 'DHCP' || newData.val() == 'STATIC')"
            },
            "ip_address": {
              ".validate": "newData.isString() && newData.val().length <= 15"
            },
            "prefix_length": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30 && newData.val() % 1 == 0"
            },
            "gateway": {
              ".validate": "newData.isString() && newData.val().length <= 15"
            },
            "primary_dns": {
              ".validate": "newData.isString() && newData.val().length <= 15"
            },
            "secondary_dns": {
              ".validate": "newData.isString() && newData.val().length <= 15"
            },
            "requested_at": {
              ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 5000"
            },
            "expires_at": {
              ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 300000"
            },
            "source": {
              ".validate": "newData.isString() && newData.val() == 'android'"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "superadmin": {
          ".validate": "!newData.exists()",
          "commands": {
            ".indexOn": [
              "status",
              "completed_at_epoch"
            ],
            "$commandId": {
              ".write": "auth != null && auth.token.avora_device_id == $deviceId && !data.exists()",
              ".validate": "newData.hasChildren(['id', 'operation', 'category', 'record_id', 'requested_by_uid', 'requested_at', 'expires_at', 'source', 'status']) && ((newData.child('operation').val() == 'update' && newData.child('replacement_json').exists() && newData.child('expected_record_json').exists() && !newData.child('backup_id').exists() && !newData.child('preview_token').exists()) || (newData.child('operation').val() == 'delete' && newData.child('preview_token').exists() && !newData.child('replacement_json').exists() && !newData.child('expected_record_json').exists() && !newData.child('backup_id').exists()) || (newData.child('operation').val() == 'delete_feedback' && newData.child('category').val() == 'feedback' && !newData.child('preview_token').exists() && !newData.child('replacement_json').exists() && !newData.child('expected_record_json').exists() && !newData.child('backup_id').exists()) || (newData.child('operation').val() == 'preview_delete' && !newData.child('preview_token').exists() && !newData.child('replacement_json').exists() && !newData.child('expected_record_json').exists() && !newData.child('backup_id').exists()) || (newData.child('operation').val() == 'restore' && newData.child('backup_id').exists() && !newData.child('replacement_json').exists() && !newData.child('expected_record_json').exists() && !newData.child('preview_token').exists()))",
              "id": {
                ".validate": "newData.isString() && newData.val() == $commandId && newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)"
              },
              "operation": {
                ".validate": "newData.isString() && (newData.val() == 'preview_delete' || newData.val() == 'delete' || newData.val() == 'delete_feedback' || newData.val() == 'update' || newData.val() == 'restore')"
              },
              "category": {
                ".validate": "newData.isString() && (newData.val() == 'zones' || newData.val() == 'seasons' || newData.val() == 'seedling_batches' || newData.val() == 'journal_events' || newData.val() == 'photos' || newData.val() == 'watering' || newData.val() == 'fertilizer' || newData.val() == 'notifications' || newData.val() == 'feedback')"
              },
              "record_id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180 && !newData.val().matches(/.*[.\\/#$\\[\\]].*/)"
              },
              "replacement_json": {
                ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 131072"
              },
              "expected_record_json": {
                ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 131072"
              },
              "backup_id": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)"
              },
              "preview_token": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
              },
              "requested_by_uid": {
                ".validate": "newData.isString() && newData.val() == auth.uid"
              },
              "requested_at": {
                ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 5000"
              },
              "expires_at": {
                ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 300000"
              },
              "source": {
                ".validate": "newData.isString() && newData.val() == 'android'"
              },
              "status": {
                ".validate": "newData.isString() && newData.val() == 'pending'"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "audit": {
            ".indexOn": "completed_at_epoch",
            ".write": false
          },
          "$other": {
            ".validate": false
          }
        },
        "user_feedback": {
          ".write": "false",
          ".validate": "newData.val() == data.val()"
        },
        "zones": {
          ".indexOn": "updated_at_epoch"
        },
        "weather": {
          "irrigation_settings": {
            "manual_watering_max_duration_seconds": {
              ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 18000 && newData.val() % 1 == 0"
            }
          }
        },
        "watering_history": {
          ".indexOn": [
            "started_at_epoch",
            "completed_at_epoch",
            "zone_id",
            "sensor_id",
            "learning_scope_id"
          ]
        },
        "sensor_history": {
          ".indexOn": [
            "sensor_id",
            "zone_id",
            "learning_scope_id"
          ]
        },
        "fertilizer_history": {
          ".indexOn": "applied_at_epoch"
        },
        "notifications": {
          ".indexOn": "created_at_epoch"
        },
        "seedling": {
          "nodes": {
            "$nodeId": {
              ".validate": "newData.val() == data.val()"
            }
          },
          "batches": {
            ".indexOn": "updated_at_epoch",
            "$batchId": {
              ".validate": "!newData.exists() || (newData.hasChildren(['batch_id', 'plant_type', 'emoji', 'variety', 'area', 'node_id', 'status', 'stage', 'sowing_date_epoch', 'estimated_emergence_epoch', 'estimated_transplant_epoch', 'seed_count', 'tray_cell_count', 'healthy_count', 'created_at_epoch', 'updated_at_epoch']) && (!newData.child('archive_reason').exists() || (newData.child('status').val() == 'ARCHIVED' && newData.child('archived_at_epoch').isNumber())) && (!newData.child('archive_reason').exists() || newData.child('archive_reason').val() != 'TRANSFERRED' || (newData.child('stage').val() == 'READY' && newData.hasChildren(['transferred_season_id', 'transferred_zone_id', 'transferred_at_epoch']))))",
              "batch_id": {
                ".validate": "newData.isString() && newData.val() == $batchId && newData.val().length > 0 && newData.val().length <= 120"
              },
              "crop_id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
              },
              "plant_type": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
              },
              "emoji": {
                ".validate": "newData.isString() && newData.val().length <= 16"
              },
              "variety": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "area": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "node_id": {
                ".validate": "newData.isString() && newData.val().matches(/^seedling-[0-9]{3}$/)"
              },
              "status": {
                ".validate": "newData.isString() && (newData.val() == 'ACTIVE' || newData.val() == 'TRANSFERRED' || newData.val() == 'ARCHIVED')"
              },
              "stage": {
                ".validate": "newData.isString() && (newData.val() == 'SOWN' || newData.val() == 'GERMINATING' || newData.val() == 'COTYLEDON' || newData.val() == 'TRUE_LEAVES' || newData.val() == 'HARDENING' || newData.val() == 'READY')"
              },
              "sowing_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "estimated_emergence_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "estimated_transplant_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('estimated_emergence_epoch').val() && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "germination_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "first_leaf_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && (!newData.parent().child('germination_date_epoch').exists() || newData.val() >= newData.parent().child('germination_date_epoch').val()) && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "true_leaves_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && (!newData.parent().child('first_leaf_date_epoch').exists() || newData.val() >= newData.parent().child('first_leaf_date_epoch').val()) && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "hardening_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && (!newData.parent().child('true_leaves_date_epoch').exists() || newData.val() >= newData.parent().child('true_leaves_date_epoch').val()) && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "ready_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && (!newData.parent().child('hardening_date_epoch').exists() || newData.val() >= newData.parent().child('hardening_date_epoch').val()) && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "seed_count": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000 && newData.val() % 1 == 0"
              },
              "tray_cell_count": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && newData.val() % 1 == 0"
              },
              "healthy_count": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('seed_count').val() && newData.val() % 1 == 0"
              },
              "archived_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "archive_reason": {
                ".validate": "newData.isString() && (newData.val() == 'MANUAL' || newData.val() == 'TRANSFERRED')"
              },
              "transferred_season_id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180"
              },
              "transferred_zone_id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
              },
              "transferred_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "created_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "updated_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('created_at_epoch').val() && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "daily_logs": {
            "$batchId": {
              "$logId": {
                ".validate": "!newData.exists() || (newData.hasChildren(['log_id', 'batch_id', 'height_cm', 'leaf_count', 'healthy_count', 'watered', 'note', 'created_at_epoch']) && newData.child('batch_id').val() == $batchId && (root.child('devices').child($deviceId).child('seedling').child('batches').child($batchId).child('status').val() == 'ACTIVE' || ((root.child('devices').child($deviceId).child('seedling').child('batches').child($batchId).child('status').val() == 'ARCHIVED' || root.child('devices').child($deviceId).child('seedling').child('batches').child($batchId).child('status').val() == 'TRANSFERRED') && data.exists() && newData.child('log_id').val() == data.child('log_id').val() && newData.child('batch_id').val() == data.child('batch_id').val() && newData.child('created_at_epoch').val() == data.child('created_at_epoch').val())))",
                "log_id": {
                  ".validate": "newData.isString() && newData.val() == $logId && newData.val().length > 0 && newData.val().length <= 120"
                },
                "batch_id": {
                  ".validate": "newData.isString() && newData.val() == $batchId"
                },
                "height_cm": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
                },
                "leaf_count": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 == 0"
                },
                "healthy_count": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= root.child('devices').child($deviceId).child('seedling').child('batches').child($batchId).child('seed_count').val() && newData.val() % 1 == 0"
                },
                "watered": {
                  ".validate": "newData.isBoolean()"
                },
                "note": {
                  ".validate": "newData.isString() && newData.val().length <= 1000"
                },
                "photo_id": {
                  ".validate": "newData.isString() && ((newData.val() == '' && newData.parent().child('photo_storage_path').val() == '') || (newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/) && (newData.parent().child('photo_storage_path').val() == '' || newData.parent().child('photo_storage_path').val() == 'devices/' + $deviceId + '/seedling/daily_logs/' + $batchId + '/' + newData.val() + '.jpg')))"
                },
                "photo_storage_path": {
                  ".validate": "newData.isString() && (newData.val() == '' || (newData.parent().child('photo_id').val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/) && newData.val() == 'devices/' + $deviceId + '/seedling/daily_logs/' + $batchId + '/' + newData.parent().child('photo_id').val() + '.jpg'))"
                },
                "created_at_epoch": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
                },
                "sensor_snapshot_available": {
                  ".validate": "newData.isBoolean()"
                },
                "sensor_snapshot_fresh": {
                  ".validate": "newData.isBoolean() && (newData.val() == false || newData.parent().child('sensor_snapshot_available').val() == true)"
                },
                "sensor_node_id": {
                  ".validate": "newData.isString() && newData.val().length <= 64 && (newData.val() == '' || newData.val().matches(/^[A-Za-z0-9_-]+$/))"
                },
                "sensor_air_temperature_c": {
                  ".validate": "newData.isNumber() && newData.val() >= -50 && newData.val() <= 100"
                },
                "sensor_air_humidity_pct": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                },
                "sensor_root_temperature_c": {
                  ".validate": "newData.isNumber() && newData.val() >= -50 && newData.val() <= 100"
                },
                "sensor_soil_moisture_available": {
                  ".validate": "newData.isBoolean()"
                },
                "sensor_soil_moisture_pct": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                },
                "sensor_soil_raw": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 65535 && newData.val() % 1 == 0"
                },
                "sensor_light_lux": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000"
                },
                "sensor_received_at_epoch": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
                },
                "sensor_captured_at_epoch": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0 && (newData.parent().child('sensor_snapshot_available').val() == false || newData.val() == newData.parent().child('created_at_epoch').val())"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "transfer_claims": {
            "$batchId": {
              ".validate": "!newData.exists() || (newData.hasChildren(['batch_id', 'zone_id', 'season_id']) && (!data.exists() || (newData.child('batch_id').val() == data.child('batch_id').val() && newData.child('zone_id').val() == data.child('zone_id').val() && newData.child('season_id').val() == data.child('season_id').val())))",
              "batch_id": {
                ".validate": "newData.isString() && newData.val() == $batchId && newData.val().length > 0 && newData.val().length <= 120"
              },
              "zone_id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
              },
              "season_id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "garden_journal": {
          "seasons": {
            ".indexOn": "updated_at_epoch"
          },
          "events": {
            ".indexOn": "occurred_at_epoch"
          },
          "photo_metadata": {
            ".indexOn": "captured_at_epoch",
            "$photoId": {
              ".validate": "newData.hasChildren(['id', 'zone_id', 'season_id', 'note', 'related_application_id', 'analysis_title', 'analysis_meta', 'analysis_context', 'analysis_advice', 'analysis_goal', 'analysis_confidence', 'growth_score', 'growth_stage', 'growth_trend', 'growth_score_delta', 'growth_signals', 'growth_previous_captured_at_epoch', 'captured_at_epoch', 'photo_kept_on_owner_phone', 'metadata_updated_at_epoch']) && ((newData.child('analysis_goal').val() == 'growth_status' && newData.child('growth_score').val() >= 0 && (newData.child('growth_trend').val() == 'FIRST_RECORD' || newData.child('growth_trend').val() == 'IMPROVING' || newData.child('growth_trend').val() == 'STABLE' || newData.child('growth_trend').val() == 'DECLINING')) || (newData.child('growth_score').val() == -1 && newData.child('growth_stage').val() == '' && newData.child('growth_trend').val() == '' && newData.child('growth_score_delta').val() == 0 && newData.child('growth_signals').val() == '' && newData.child('growth_previous_captured_at_epoch').val() == 0))",
              "id": {
                ".validate": "newData.isString() && newData.val() == $photoId && newData.val().length > 0 && newData.val().length <= 80"
              },
              "zone_id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
              },
              "season_id": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "note": {
                ".validate": "newData.isString() && newData.val().length <= 1000"
              },
              "related_application_id": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "analysis_title": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "analysis_meta": {
                ".validate": "newData.isString() && newData.val().length <= 1000"
              },
              "analysis_context": {
                ".validate": "newData.isString() && newData.val().length <= 5000"
              },
              "analysis_advice": {
                ".validate": "newData.isString() && newData.val().length <= 5000"
              },
              "analysis_goal": {
                ".validate": "newData.isString() && (newData.val() == '' || newData.val() == 'health_screening' || newData.val() == 'growth_status')"
              },
              "analysis_confidence": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
              },
              "growth_score": {
                ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 100 && newData.val() % 1 == 0"
              },
              "growth_stage": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "growth_trend": {
                ".validate": "newData.isString() && (newData.val() == '' || newData.val() == 'FIRST_RECORD' || newData.val() == 'IMPROVING' || newData.val() == 'STABLE' || newData.val() == 'DECLINING')"
              },
              "growth_score_delta": {
                ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100 && newData.val() % 1 == 0"
              },
              "growth_signals": {
                ".validate": "newData.isString() && newData.val().length <= 1000"
              },
              "growth_previous_captured_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "captured_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "photo_kept_on_owner_phone": {
                ".validate": "newData.isBoolean() && newData.val() == true"
              },
              "metadata_updated_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "feedback_devices": {
      "$deviceId": {
        ".read": "auth != null && auth.token.avora_device_id == $deviceId",
        "user_feedback": {
          ".indexOn": "created_at",
          ".validate": "newData.hasChildren()",
          "$feedbackId": {
            ".write": "auth != null && !data.exists() && (auth.token.avora_device_id == $deviceId || root.child('device_access').child($deviceId).child(auth.uid).child('approved').val() == true)",
            ".validate": "!data.exists() && newData.hasChildren(['id', 'type', 'area', 'area_label', 'subject', 'description', 'status', 'created_at', 'device_id', 'source', 'user_id'])",
            "id": {
              ".validate": "(!data.exists() && newData.isString() && newData.val() == $feedbackId && newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)) || (data.exists() && newData.val() == data.val())"
            },
            "type": {
              ".validate": "(!data.exists() && newData.isString() && (newData.val() == 'problem' || newData.val() == 'suggestion' || newData.val() == 'question')) || (data.exists() && newData.val() == data.val())"
            },
            "area": {
              ".validate": "(!data.exists() && newData.isString() && (newData.val() == 'general' || newData.val() == 'irrigation_hardware' || newData.val() == 'plant_assistant' || newData.val() == 'fertilization' || newData.val() == 'plant_journal' || newData.val() == 'notifications' || newData.val() == 'settings')) || (data.exists() && newData.val() == data.val())"
            },
            "area_label": {
              ".validate": "(!data.exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 80) || (data.exists() && newData.val() == data.val())"
            },
            "subject": {
              ".validate": "(!data.exists() && newData.isString() && newData.val().length >= 4 && newData.val().length <= 80) || (data.exists() && newData.val() == data.val())"
            },
            "description": {
              ".validate": "(!data.exists() && newData.isString() && newData.val().length >= 10 && newData.val().length <= 1500) || (data.exists() && newData.val() == data.val())"
            },
            "contact_email": {
              ".validate": "(!data.exists() && newData.isString() && newData.val().length <= 254 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)) || (data.exists() && newData.val() == data.val())"
            },
            "diagnostics": {
              ".validate": "(!data.exists() && newData.hasChildren(['app_version', 'android_version', 'android_sdk', 'manufacturer', 'model'])) || data.exists()",
              "app_version": {
                ".validate": "(!data.exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 40) || (data.exists() && newData.val() == data.val())"
              },
              "android_version": {
                ".validate": "(!data.exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 40) || (data.exists() && newData.val() == data.val())"
              },
              "android_sdk": {
                ".validate": "(!data.exists() && newData.isNumber() && newData.val() >= 26 && newData.val() <= 100) || (data.exists() && newData.val() == data.val())"
              },
              "manufacturer": {
                ".validate": "(!data.exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 80) || (data.exists() && newData.val() == data.val())"
              },
              "model": {
                ".validate": "(!data.exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 120) || (data.exists() && newData.val() == data.val())"
              },
              "$other": {
                ".validate": false
              }
            },
            "status": {
              ".validate": "(!data.exists() && newData.isString() && newData.val() == 'new') || (data.exists() && newData.val() == data.val())"
            },
            "created_at": {
              ".validate": "(!data.exists() && newData.isNumber() && newData.val() > 0 && newData.val() <= now + 5000) || (data.exists() && newData.val() == data.val())"
            },
            "device_id": {
              ".validate": "(!data.exists() && newData.isString() && newData.val() == $deviceId) || (data.exists() && newData.val() == data.val())"
            },
            "source": {
              ".validate": "(!data.exists() && newData.isString() && newData.val() == 'android') || (data.exists() && newData.val() == data.val())"
            },
            "user_id": {
              ".validate": "(!data.exists() && newData.isString() && newData.val() == auth.uid) || (data.exists() && newData.val() == data.val())"
            },
            "email_delivery": {
              ".validate": "data.exists() && data.child('status').exists() == newData.child('status').exists() && data.child('lease_token').exists() == newData.child('lease_token').exists() && data.child('claimed_at_epoch').exists() == newData.child('claimed_at_epoch').exists() && data.child('attempt_count').exists() == newData.child('attempt_count').exists() && data.child('sent_at_epoch').exists() == newData.child('sent_at_epoch').exists() && data.child('message_id').exists() == newData.child('message_id').exists() && data.child('failed_at_epoch').exists() == newData.child('failed_at_epoch').exists() && data.child('next_attempt_at_epoch').exists() == newData.child('next_attempt_at_epoch').exists() && data.child('last_error').exists() == newData.child('last_error').exists() && data.child('sender').exists() == newData.child('sender').exists()",
              "status": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "lease_token": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "claimed_at_epoch": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "attempt_count": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "sent_at_epoch": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "message_id": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "failed_at_epoch": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "next_attempt_at_epoch": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "last_error": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "sender": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
