{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "$deviceId": {
        ".read": "auth != null && auth.token.avora_device_id == $deviceId",
        ".write": "auth != null && auth.token.avora_device_id == $deviceId && newData.child('user_feedback_email_state/activation_epoch').val() == data.child('user_feedback_email_state/activation_epoch').val()",
        "user_feedback_email_state": {
          "activation_epoch": {
            ".validate": "newData.val() == data.val()"
          },
          "$other": {
            ".validate": false
          }
        },
        "commands": {
          "network_configuration": {
            ".validate": "newData.hasChildren(['requested', 'request_id', 'interface', 'mode', 'ip_address', 'prefix_length', 'gateway', 'primary_dns', 'secondary_dns', 'requested_at', 'expires_at', 'source'])",
            "requested": {
              ".validate": "newData.isBoolean() && newData.val() == true"
            },
            "request_id": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)"
            },
            "interface": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32 && newData.val() != 'lo' && newData.val().matches(/^[A-Za-z0-9_.:-]+$/)"
            },
            "mode": {
              ".validate": "newData.isString() && (newData.val() == 'DHCP' || newData.val() == 'STATIC')"
            },
            "ip_address": {
              ".validate": "newData.isString() && newData.val().length <= 15"
            },
            "prefix_length": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30 && newData.val() % 1 == 0"
            },
            "gateway": {
              ".validate": "newData.isString() && newData.val().length <= 15"
            },
            "primary_dns": {
              ".validate": "newData.isString() && newData.val().length <= 15"
            },
            "secondary_dns": {
              ".validate": "newData.isString() && newData.val().length <= 15"
            },
            "requested_at": {
              ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 5000"
            },
            "expires_at": {
              ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 300000"
            },
            "source": {
              ".validate": "newData.isString() && newData.val() == 'android'"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "user_feedback": {
          ".indexOn": "created_at",
          ".validate": "newData.hasChildren()",
          "$feedbackId": {
            ".write": "auth != null && auth.token.avora_device_id == $deviceId && !data.exists()",
            ".validate": "(!data.exists() && newData.hasChildren(['id', 'type', 'area', 'area_label', 'subject', 'description', 'status', 'created_at', 'device_id', 'source', 'user_id'])) || (data.exists() && data.child('id').exists() == newData.child('id').exists() && data.child('type').exists() == newData.child('type').exists() && data.child('area').exists() == newData.child('area').exists() && data.child('area_label').exists() == newData.child('area_label').exists() && data.child('subject').exists() == newData.child('subject').exists() && data.child('description').exists() == newData.child('description').exists() && data.child('contact_email').exists() == newData.child('contact_email').exists() && data.child('diagnostics').exists() == newData.child('diagnostics').exists() && data.child('status').exists() == newData.child('status').exists() && data.child('created_at').exists() == newData.child('created_at').exists() && data.child('device_id').exists() == newData.child('device_id').exists() && data.child('source').exists() == newData.child('source').exists() && data.child('user_id').exists() == newData.child('user_id').exists() && data.child('email_delivery').exists() == newData.child('email_delivery').exists())",
            "id": {
              ".validate": "(!data.exists() && newData.isString() && newData.val() == $feedbackId && newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)) || (data.exists() && newData.val() == data.val())"
            },
            "type": {
              ".validate": "(!data.exists() && newData.isString() && (newData.val() == 'problem' || newData.val() == 'suggestion' || newData.val() == 'question')) || (data.exists() && newData.val() == data.val())"
            },
            "area": {
              ".validate": "(!data.exists() && newData.isString() && (newData.val() == 'general' || newData.val() == 'irrigation_hardware' || newData.val() == 'plant_assistant' || newData.val() == 'fertilization' || newData.val() == 'plant_journal' || newData.val() == 'notifications' || newData.val() == 'settings')) || (data.exists() && newData.val() == data.val())"
            },
            "area_label": {
              ".validate": "(!data.exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 80) || (data.exists() && newData.val() == data.val())"
            },
            "subject": {
              ".validate": "(!data.exists() && newData.isString() && newData.val().length >= 4 && newData.val().length <= 80) || (data.exists() && newData.val() == data.val())"
            },
            "description": {
              ".validate": "(!data.exists() && newData.isString() && newData.val().length >= 10 && newData.val().length <= 1500) || (data.exists() && newData.val() == data.val())"
            },
            "contact_email": {
              ".validate": "(!data.exists() && newData.isString() && newData.val().length <= 254 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)) || (data.exists() && newData.val() == data.val())"
            },
            "diagnostics": {
              ".validate": "(!data.exists() && newData.hasChildren(['app_version', 'android_version', 'android_sdk', 'manufacturer', 'model'])) || data.exists()",
              "app_version": {
                ".validate": "(!data.exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 40) || (data.exists() && newData.val() == data.val())"
              },
              "android_version": {
                ".validate": "(!data.exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 40) || (data.exists() && newData.val() == data.val())"
              },
              "android_sdk": {
                ".validate": "(!data.exists() && newData.isNumber() && newData.val() >= 26 && newData.val() <= 100) || (data.exists() && newData.val() == data.val())"
              },
              "manufacturer": {
                ".validate": "(!data.exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 80) || (data.exists() && newData.val() == data.val())"
              },
              "model": {
                ".validate": "(!data.exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 120) || (data.exists() && newData.val() == data.val())"
              },
              "$other": {
                ".validate": false
              }
            },
            "status": {
              ".validate": "(!data.exists() && newData.isString() && newData.val() == 'new') || (data.exists() && newData.val() == data.val())"
            },
            "created_at": {
              ".validate": "(!data.exists() && newData.isNumber() && newData.val() > 0 && newData.val() <= now + 5000) || (data.exists() && newData.val() == data.val())"
            },
            "device_id": {
              ".validate": "(!data.exists() && newData.isString() && newData.val() == $deviceId) || (data.exists() && newData.val() == data.val())"
            },
            "source": {
              ".validate": "(!data.exists() && newData.isString() && newData.val() == 'android') || (data.exists() && newData.val() == data.val())"
            },
            "user_id": {
              ".validate": "(!data.exists() && newData.isString() && newData.val() == auth.uid) || (data.exists() && newData.val() == data.val())"
            },
            "email_delivery": {
              ".validate": "data.exists() && data.child('status').exists() == newData.child('status').exists() && data.child('lease_token').exists() == newData.child('lease_token').exists() && data.child('claimed_at_epoch').exists() == newData.child('claimed_at_epoch').exists() && data.child('attempt_count').exists() == newData.child('attempt_count').exists() && data.child('sent_at_epoch').exists() == newData.child('sent_at_epoch').exists() && data.child('message_id').exists() == newData.child('message_id').exists() && data.child('failed_at_epoch').exists() == newData.child('failed_at_epoch').exists() && data.child('next_attempt_at_epoch').exists() == newData.child('next_attempt_at_epoch').exists() && data.child('last_error').exists() == newData.child('last_error').exists() && data.child('sender').exists() == newData.child('sender').exists()",
              "status": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "lease_token": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "claimed_at_epoch": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "attempt_count": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "sent_at_epoch": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "message_id": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "failed_at_epoch": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "next_attempt_at_epoch": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "last_error": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "sender": {
                ".validate": "data.exists() && newData.val() == data.val()"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "seedling": {
          "nodes": {
            "$nodeId": {
              ".validate": "newData.val() == data.val()"
            }
          },
          "batches": {
            "$batchId": {
              ".validate": "!newData.exists() || newData.hasChildren(['batch_id', 'plant_type', 'emoji', 'variety', 'area', 'node_id', 'status', 'stage', 'sowing_date_epoch', 'estimated_emergence_epoch', 'estimated_transplant_epoch', 'seed_count', 'tray_cell_count', 'healthy_count', 'created_at_epoch', 'updated_at_epoch'])",
              "batch_id": {
                ".validate": "newData.isString() && newData.val() == $batchId && newData.val().length > 0 && newData.val().length <= 120"
              },
              "plant_type": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
              },
              "emoji": {
                ".validate": "newData.isString() && newData.val().length <= 16"
              },
              "variety": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "area": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "node_id": {
                ".validate": "newData.isString() && newData.val().matches(/^seedling-[0-9]{3}$/)"
              },
              "status": {
                ".validate": "newData.isString() && (newData.val() == 'ACTIVE' || newData.val() == 'TRANSFERRED' || newData.val() == 'ARCHIVED')"
              },
              "stage": {
                ".validate": "newData.isString() && (newData.val() == 'SOWN' || newData.val() == 'GERMINATING' || newData.val() == 'COTYLEDON' || newData.val() == 'TRUE_LEAVES' || newData.val() == 'HARDENING' || newData.val() == 'READY')"
              },
              "sowing_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "estimated_emergence_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "estimated_transplant_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('estimated_emergence_epoch').val() && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "germination_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "first_leaf_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && (!newData.parent().child('germination_date_epoch').exists() || newData.val() >= newData.parent().child('germination_date_epoch').val()) && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "true_leaves_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && (!newData.parent().child('first_leaf_date_epoch').exists() || newData.val() >= newData.parent().child('first_leaf_date_epoch').val()) && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "hardening_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && (!newData.parent().child('true_leaves_date_epoch').exists() || newData.val() >= newData.parent().child('true_leaves_date_epoch').val()) && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "ready_date_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('sowing_date_epoch').val() && (!newData.parent().child('hardening_date_epoch').exists() || newData.val() >= newData.parent().child('hardening_date_epoch').val()) && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "seed_count": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000 && newData.val() % 1 == 0"
              },
              "tray_cell_count": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000 && newData.val() % 1 == 0"
              },
              "healthy_count": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('seed_count').val() && newData.val() % 1 == 0"
              },
              "created_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "updated_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('created_at_epoch').val() && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "daily_logs": {
            "$batchId": {
              "$logId": {
                ".validate": "!newData.exists() || (newData.hasChildren(['log_id', 'batch_id', 'height_cm', 'leaf_count', 'healthy_count', 'watered', 'note', 'created_at_epoch']) && newData.child('batch_id').val() == $batchId && root.child('devices').child($deviceId).child('seedling').child('batches').child($batchId).exists())",
                "log_id": {
                  ".validate": "newData.isString() && newData.val() == $logId && newData.val().length > 0 && newData.val().length <= 120"
                },
                "batch_id": {
                  ".validate": "newData.isString() && newData.val() == $batchId"
                },
                "height_cm": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
                },
                "leaf_count": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 == 0"
                },
                "healthy_count": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= root.child('devices').child($deviceId).child('seedling').child('batches').child($batchId).child('seed_count').val() && newData.val() % 1 == 0"
                },
                "watered": {
                  ".validate": "newData.isBoolean()"
                },
                "note": {
                  ".validate": "newData.isString() && newData.val().length <= 1000"
                },
                "photo_id": {
                  ".validate": "newData.isString() && ((newData.val() == '' && newData.parent().child('photo_storage_path').val() == '') || (newData.val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/) && (newData.parent().child('photo_storage_path').val() == '' || newData.parent().child('photo_storage_path').val() == 'devices/' + $deviceId + '/seedling/daily_logs/' + $batchId + '/' + newData.val() + '.jpg')))"
                },
                "photo_storage_path": {
                  ".validate": "newData.isString() && (newData.val() == '' || (newData.parent().child('photo_id').val().matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/) && newData.val() == 'devices/' + $deviceId + '/seedling/daily_logs/' + $batchId + '/' + newData.parent().child('photo_id').val() + '.jpg'))"
                },
                "created_at_epoch": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "garden_journal": {
          "photo_metadata": {
            "$photoId": {
              ".validate": "newData.hasChildren(['id', 'zone_id', 'season_id', 'note', 'related_application_id', 'analysis_title', 'analysis_meta', 'analysis_context', 'analysis_advice', 'analysis_goal', 'analysis_confidence', 'growth_score', 'growth_stage', 'growth_trend', 'growth_score_delta', 'growth_signals', 'growth_previous_captured_at_epoch', 'captured_at_epoch', 'photo_kept_on_owner_phone', 'metadata_updated_at_epoch']) && ((newData.child('analysis_goal').val() == 'growth_status' && newData.child('growth_score').val() >= 0 && (newData.child('growth_trend').val() == 'FIRST_RECORD' || newData.child('growth_trend').val() == 'IMPROVING' || newData.child('growth_trend').val() == 'STABLE' || newData.child('growth_trend').val() == 'DECLINING')) || (newData.child('growth_score').val() == -1 && newData.child('growth_stage').val() == '' && newData.child('growth_trend').val() == '' && newData.child('growth_score_delta').val() == 0 && newData.child('growth_signals').val() == '' && newData.child('growth_previous_captured_at_epoch').val() == 0))",
              "id": {
                ".validate": "newData.isString() && newData.val() == $photoId && newData.val().length > 0 && newData.val().length <= 80"
              },
              "zone_id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
              },
              "season_id": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "note": {
                ".validate": "newData.isString() && newData.val().length <= 1000"
              },
              "related_application_id": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "analysis_title": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "analysis_meta": {
                ".validate": "newData.isString() && newData.val().length <= 1000"
              },
              "analysis_context": {
                ".validate": "newData.isString() && newData.val().length <= 5000"
              },
              "analysis_advice": {
                ".validate": "newData.isString() && newData.val().length <= 5000"
              },
              "analysis_goal": {
                ".validate": "newData.isString() && (newData.val() == '' || newData.val() == 'health_screening' || newData.val() == 'growth_status')"
              },
              "analysis_confidence": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 == 0"
              },
              "growth_score": {
                ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 100 && newData.val() % 1 == 0"
              },
              "growth_stage": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "growth_trend": {
                ".validate": "newData.isString() && (newData.val() == '' || newData.val() == 'FIRST_RECORD' || newData.val() == 'IMPROVING' || newData.val() == 'STABLE' || newData.val() == 'DECLINING')"
              },
              "growth_score_delta": {
                ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100 && newData.val() % 1 == 0"
              },
              "growth_signals": {
                ".validate": "newData.isString() && newData.val().length <= 1000"
              },
              "growth_previous_captured_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "captured_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "photo_kept_on_owner_phone": {
                ".validate": "newData.isBoolean() && newData.val() == true"
              },
              "metadata_updated_at_epoch": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 4102444800 && newData.val() % 1 == 0"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
